---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getProjectStatusLabel } from "../data/projects";
import { getTopicLabel } from "../data/topics";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex(({ id }) => id === project.id);
const nextProject = currentIndex >= 0 ? projects[currentIndex + 1] : undefined;
---

<BaseLayout title={project.data.title} description={project.data.description} section="projects">
  <article>
    <header class="project-hero container" data-enter>
      <a class="text-link" href="/projects/">← All projects</a>
      <div class="project-hero-grid">
        <div>
          <p class="section-kicker">
            {project.data.topics.slice(0, 2).map(getTopicLabel).join(" · ")}
          </p>
          <h1>{project.data.title}</h1>
          <p class="project-outcome">{project.data.outcome}</p>
          <div class="project-links">
            {
              project.data.links.demo && (
                <a
                  class="button"
                  href={project.data.links.demo}
                  target="_blank"
                  rel="noopener external"
                >
                  Visit live project ↗
                </a>
              )
            }
            {
              project.data.links.repository && (
                <a
                  class:list={["button", { "button-secondary": project.data.links.demo }]}
                  href={project.data.links.repository}
                  target="_blank"
                  rel="noopener external"
                >
                  View repository ↗
                </a>
              )
            }
          </div>
        </div>
        <dl class="signal-list">
          <div><dt>Role</dt><dd>{project.data.role}</dd></div>
          <div><dt>Period</dt><dd>{project.data.period}</dd></div>
          <div><dt>Status</dt><dd>{getProjectStatusLabel(project.data.status)}</dd></div>
          <div><dt>Stack</dt><dd>{project.data.stack.slice(0, 4).join(" · ")}</dd></div>
        </dl>
      </div>
    </header>

    <ProjectVisual projectId={project.id} contained />

    <div class="container case-study section">
      <div class="prose">
        <Content />
      </div>
      {
        headings.filter(({ depth }) => depth === 2).length > 1 && (
          <aside class="case-study-aside">
            <h2>On this page</h2>
            <ul>
              {headings
                .filter(({ depth }) => depth === 2)
                .map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
            </ul>
          </aside>
        )
      }
    </div>

    <footer class="project-continuation container" id="project-continuation" data-reveal>
      <p class="section-kicker">{nextProject ? "Next project" : "Continue exploring"}</p>
      <a href={nextProject ? `/projects/${nextProject.id}/` : "/projects/"}>
        <span>
          <strong>{nextProject?.data.title ?? "All projects"}</strong>
          <small>
            {nextProject?.data.outcome ?? "Return to the complete project collection."}
          </small>
        </span>
        <i aria-hidden="true">→</i>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-hero {
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(3rem, 6vw, 5rem);
  }

  .project-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.45fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .project-hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 670;
    letter-spacing: -0.072em;
    line-height: 0.92;
  }

  .project-outcome {
    max-width: 49rem;
    margin: 1.6rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 2vw, 1.32rem);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .signal-list {
    margin: 0;
  }

  .signal-list div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-block: 0.7rem;
  }

  .signal-list div:last-child {
    border-bottom: 1px solid var(--border);
  }

  .signal-list dt {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .signal-list dd {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 550;
  }

  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .prose {
    min-width: 0;
    max-width: var(--article-width);
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    margin: 4rem 0 1.1rem;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 630;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .prose :global(h3) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--text-soft);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 620;
  }

  .prose :global(a) {
    color: var(--accent-ink);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li + li) {
    margin-top: 0.45rem;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    border-left: 3px solid var(--accent);
    padding: 0.2rem 0 0.2rem 1.25rem;
  }

  .prose :global(code) {
    border-radius: 0.25rem;
    background: var(--surface);
    padding: 0.12rem 0.3rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--dark) !important;
    padding: 1.2rem;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--dark-text);
  }

  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 0.7rem 1rem 0.7rem 0;
    text-align: left;
  }

  .case-study-aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .case-study-aside h2 {
    margin: 0 0 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-aside ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study-aside li {
    border-top: 1px solid var(--border);
  }

  .case-study-aside li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .case-study-aside a {
    display: block;
    padding-block: 0.65rem;
    color: var(--text-soft);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .case-study-aside a:hover {
    color: var(--accent);
  }

  .project-continuation {
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(5rem, 10vw, 9rem);
  }

  .project-continuation > a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }

  .project-continuation span {
    display: grid;
    gap: 0.6rem;
  }

  .project-continuation strong {
    font-size: clamp(1.8rem, 5vw, 3.75rem);
    font-weight: 630;
    letter-spacing: -0.052em;
    line-height: 1;
    transition: color var(--motion-fast) ease;
  }

  .project-continuation small {
    max-width: 48rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .project-continuation i {
    color: var(--accent);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-style: normal;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .project-continuation > a:hover strong {
    color: var(--accent);
  }

  .project-continuation > a:hover i {
    transform: translateX(0.25rem);
  }

  @media (max-width: 56rem) {
    .project-hero-grid,
    .case-study {
      grid-template-columns: 1fr;
    }

    .case-study-aside {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .project-hero h1 {
      overflow-wrap: anywhere;
    }

    .project-continuation > a {
      gap: 1rem;
    }
  }
</style>
