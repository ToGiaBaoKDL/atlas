---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectTopology from "./ProjectTopology.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description} section="work">
  <article>
    <header class="project-hero container">
      <a class="text-link" href="/work/">← All work</a>
      <div class="project-hero-grid">
        <div>
          <p class="section-kicker">{project.data.topics.slice(0, 2).join(" · ")}</p>
          <h1>{project.data.title}</h1>
          <p class="project-outcome">{project.data.outcome}</p>
          <div class="project-links">
            {
              project.data.links.repository && (
                <a class="button" href={project.data.links.repository} rel="external">
                  View repository ↗
                </a>
              )
            }
          </div>
        </div>
        <dl class="signal-list">
          <div><dt>Role</dt><dd>{project.data.role}</dd></div>
          <div><dt>Period</dt><dd>{project.data.period}</dd></div>
          <div><dt>Status</dt><dd>{project.data.statusLabel}</dd></div>
          <div><dt>Stack</dt><dd>{project.data.stack.slice(0, 4).join(" · ")}</dd></div>
        </dl>
      </div>
    </header>

    {
      project.data.slug === "mini-lakehouse" && (
        <section class="container" aria-label="Architecture overview">
          <ProjectTopology />
        </section>
      )
    }

    <div class="container case-study section">
      <div class="prose">
        <Content />
      </div>
      {
        headings.filter(({ depth }) => depth === 2).length > 1 && (
          <aside class="case-study-aside">
            <h2>On this page</h2>
            <ul>
              {headings
                .filter(({ depth }) => depth === 2)
                .map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>
