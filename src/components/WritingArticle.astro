---
import { render, type CollectionEntry } from "astro:content";
import { getPublishedWriting, selectWritingSeries } from "../data/content";
import { getWritingSeries, getWritingSeriesPath } from "../data/series";
import { getWritingSocialCard } from "../data/social-cards";
import { site } from "../data/site";
import { getTopicLabel } from "../data/topics";
import BaseLayout from "../layouts/BaseLayout.astro";
import TableOfContents from "./TableOfContents.astro";

interface Props {
  entry: CollectionEntry<"writing">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = await getPublishedWriting();
const seriesEntries = entry.data.series
  ? selectWritingSeries(entries, entry.data.series.id).entries
  : [];
const seriesIndex = seriesEntries.findIndex(({ id }) => id === entry.id);
const previousInSeries = seriesIndex > 0 ? seriesEntries[seriesIndex - 1] : undefined;
const nextInSeries = seriesIndex >= 0 ? seriesEntries[seriesIndex + 1] : undefined;
const dateFormatter = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const topicLabels = entry.data.topics.map(getTopicLabel);
const series = entry.data.series ? getWritingSeries(entry.data.series.id) : undefined;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialCard = getWritingSocialCard(entry);
const socialImage = Astro.site ? new URL(socialCard.path, Astro.site).href : undefined;
const personId = Astro.site ? `${new URL("/", Astro.site).href}#person` : undefined;
const articleSchema = {
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: personId ? { "@id": personId } : { "@type": "Person", name: site.name },
  keywords: topicLabels,
  ...(series && entry.data.series
    ? {
        isPartOf: {
          "@type": "CreativeWorkSeries",
          identifier: series.id,
          name: series.name,
          description: series.description,
        },
        position: entry.data.series.part,
      }
    : {}),
  ...(socialImage ? { image: socialImage } : {}),
  ...(canonical
    ? { mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical }
    : {}),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  section="writing"
  ogType="article"
  image={socialCard.path}
  imageAlt={socialCard.alt}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={topicLabels}
  schema={articleSchema}
>
  <article>
    <header class="article-hero container" data-enter>
      <a class="text-link" href="/writing/">← All writing</a>
      <p class="section-kicker">
        {
          series && entry.data.series
            ? `${series.name} · Part ${String(entry.data.series.part).padStart(2, "0")}`
            : topicLabels.slice(0, 2).join(" · ")
        }
      </p>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        <span>
          Published <time datetime={entry.data.publishedAt.toISOString()}
            >{dateFormatter.format(entry.data.publishedAt)}</time
          >
        </span>
        {
          entry.data.updatedAt && (
            <span>
              Updated{" "}
              <time datetime={entry.data.updatedAt.toISOString()}>
                {dateFormatter.format(entry.data.updatedAt)}
              </time>
            </span>
          )
        }
      </div>
      <ul class="article-topics" aria-label="Topics">
        {
          entry.data.topics.map((topic) => (
            <li>
              <a href={`/topics/${topic}/`}>{getTopicLabel(topic)}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="container article-body section">
      <TableOfContents headings={headings} mode="mobile" />
      <div class="prose">
        <Content />
      </div>
      <TableOfContents headings={headings} mode="desktop" />
    </div>

    {
      series && entry.data.series && (
        <nav class="container series-navigation" aria-label={`${series.name} series navigation`}>
          <header>
            <p class="section-kicker">
              Series · Part {String(entry.data.series.part).padStart(2, "0")} of {series.totalParts}
            </p>
            <a href={getWritingSeriesPath(series.id)}>{series.name}</a>
          </header>
          <div class="series-links">
            {previousInSeries && (
              <a class="series-link series-link-previous" href={`/writing/${previousInSeries.id}/`}>
                <small>← Previous part</small>
                <strong>{previousInSeries.data.title}</strong>
              </a>
            )}
            {nextInSeries && (
              <a class="series-link series-link-next" href={`/writing/${nextInSeries.id}/`}>
                <small>Next part →</small>
                <strong>{nextInSeries.data.title}</strong>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(3rem, 7vw, 5.5rem);
  }

  .article-hero .section-kicker {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .article-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 670;
    letter-spacing: -0.067em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .article-description {
    max-width: 48rem;
    margin: 1.5rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    margin-top: 1.8rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .article-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .article-topics a {
    display: block;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elevated);
    padding: 0.25rem 0.55rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .article-topics a:hover,
  .article-topics a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .article-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .series-navigation {
    margin-bottom: clamp(4rem, 9vw, 7rem);
    border-block: 1px solid var(--border);
    padding-block: 1.5rem;
  }

  .series-navigation > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .series-navigation > header .section-kicker {
    margin: 0;
  }

  .series-navigation > header > a {
    color: var(--text-soft);
    font-size: 0.85rem;
    font-weight: 590;
    text-decoration: none;
  }

  .series-navigation > header > a:hover,
  .series-navigation > header > a:focus-visible {
    color: var(--accent);
  }

  .series-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .series-link {
    display: grid;
    min-width: 0;
    gap: 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  .series-link:hover,
  .series-link:focus-visible {
    border-color: var(--accent);
    background: var(--surface);
  }

  .series-link small {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .series-link strong {
    max-width: 28rem;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 620;
    line-height: 1.25;
  }

  .series-link-next {
    grid-column: 2;
    justify-items: end;
    text-align: right;
  }

  @media (max-width: 56rem) {
    .article-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .article-hero h1 {
      overflow-wrap: anywhere;
    }

    .series-navigation > header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

    .series-links {
      grid-template-columns: 1fr;
    }

    .series-link-next {
      grid-column: 1;
    }
  }
</style>
