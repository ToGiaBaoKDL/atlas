---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getWritingMaturityLabel, getWritingTopicLabel } from "../data/topics";
import BaseLayout from "../layouts/BaseLayout.astro";
import TableOfContents from "./TableOfContents.astro";
import WritingList from "./WritingList.astro";

interface Props {
  entry: CollectionEntry<"writing">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = await getCollection("writing", ({ data }) => !data.draft);
const related = entries
  .filter(({ id }) => id !== entry.id)
  .map((candidate) => ({
    candidate,
    relevance: candidate.data.topics.filter((topic) => entry.data.topics.includes(topic)).length,
  }))
  .filter(({ relevance }) => relevance > 0)
  .sort(
    (a, b) =>
      b.relevance - a.relevance ||
      b.candidate.data.publishedAt.valueOf() - a.candidate.data.publishedAt.valueOf(),
  )
  .slice(0, 3)
  .map(({ candidate }) => candidate);

const dateFormatter = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const topicLabels = entry.data.topics.map(getWritingTopicLabel);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const personId = Astro.site ? `${new URL("/", Astro.site).href}#person` : undefined;
const articleSchema = {
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: personId ? { "@id": personId } : { "@type": "Person", name: "Tô Gia Bảo" },
  keywords: topicLabels,
  ...(canonical ? { mainEntityOfPage: canonical, url: canonical } : {}),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  section="writing"
  ogType="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  schema={articleSchema}
>
  <article>
    <header class="article-hero container" data-enter>
      <a class="text-link" href="/writing/">← All writing</a>
      <p class="section-kicker">{topicLabels.slice(0, 2).join(" · ")}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        <span>
          Published <time datetime={entry.data.publishedAt.toISOString()}
            >{dateFormatter.format(entry.data.publishedAt)}</time
          >
        </span>
        {
          entry.data.updatedAt && (
            <span>
              Updated{" "}
              <time datetime={entry.data.updatedAt.toISOString()}>
                {dateFormatter.format(entry.data.updatedAt)}
              </time>
            </span>
          )
        }
        <span>{getWritingMaturityLabel(entry.data.maturity)}</span>
      </div>
      <ul class="article-topics" aria-label="Topics">
        {
          entry.data.topics.map((topic) => (
            <li>
              <a href={`/topics/${topic}/`}>{getWritingTopicLabel(topic)}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="container article-body section">
      <TableOfContents headings={headings} mode="mobile" />
      <div class="prose">
        <Content />
      </div>
      <TableOfContents headings={headings} mode="desktop" />
    </div>

    {
      related.length > 0 && (
        <section class="container related-writing" aria-labelledby="related-writing-heading">
          <p class="section-kicker">Continue reading</p>
          <h2 id="related-writing-heading">Related writing</h2>
          <WritingList entries={related} headingLevel="h3" />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(3rem, 7vw, 5.5rem);
  }

  .article-hero .section-kicker {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .article-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 670;
    letter-spacing: -0.067em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .article-description {
    max-width: 48rem;
    margin: 1.5rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    margin-top: 1.8rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .article-meta span:last-child {
    color: var(--accent);
  }

  .article-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .article-topics a {
    display: block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .article-topics a:hover,
  .article-topics a:focus-visible {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .article-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .related-writing {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .related-writing > h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 630;
    letter-spacing: -0.045em;
  }

  @media (max-width: 56rem) {
    .article-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .article-hero h1 {
      overflow-wrap: anywhere;
    }
  }
</style>
