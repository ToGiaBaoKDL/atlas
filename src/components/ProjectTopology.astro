---
const stages = [
  { number: "01", label: "Define", title: "Data contracts", detail: "Schemas and ownership" },
  { number: "02", label: "Land", title: "Ingest safely", detail: "Idempotent publication" },
  { number: "03", label: "Refine", title: "Transform", detail: "Curated domain data" },
  { number: "04", label: "Verify", title: "Quality gates", detail: "Tests before release" },
  { number: "05", label: "Deliver", title: "Serve", detail: "Analytics and apps" },
];
---

<figure class="project-workflow">
  <div class="workflow-heading">
    <div>
      <span>DELIVERY WORKFLOW</span>
      <strong>Contract to trusted data product</strong>
    </div>
    <span class="workflow-status"><i></i> DEPLOYED</span>
  </div>

  <ol class="workflow-track" aria-label="Mini Lakehouse delivery workflow">
    {
      stages.map((stage) => (
        <li>
          <span class="workflow-number">{stage.number}</span>
          <small>{stage.label}</small>
          <strong>{stage.title}</strong>
          <p>{stage.detail}</p>
        </li>
      ))
    }
  </ol>

  <div class="workflow-operations">
    <span>OPERATIONS</span>
    <div>
      <span>Orchestration</span>
      <span>Observability</span>
      <span>Immutable releases</span>
    </div>
  </div>
</figure>
