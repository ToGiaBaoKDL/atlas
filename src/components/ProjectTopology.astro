---
import VisualHeader from "./VisualHeader.astro";

const stages = [
  { number: "01", label: "Define", title: "Data contracts", detail: "Schemas and ownership" },
  { number: "02", label: "Land", title: "Ingest safely", detail: "Idempotent publication" },
  { number: "03", label: "Refine", title: "Transform", detail: "Curated domain data" },
  { number: "04", label: "Verify", title: "Quality gates", detail: "Tests before release" },
  { number: "05", label: "Deliver", title: "Serve", detail: "Analytics and apps" },
];
---

<figure class="project-workflow">
  <VisualHeader
    eyebrow="Delivery workflow"
    title="Contract to trusted data product"
    status="Deployed"
  />

  <ol class="workflow-track" aria-label="Mini Lakehouse delivery workflow">
    {
      stages.map((stage) => (
        <li>
          <span class="workflow-number">{stage.number}</span>
          <small>{stage.label}</small>
          <strong>{stage.title}</strong>
          <p>{stage.detail}</p>
        </li>
      ))
    }
  </ol>

  <div class="workflow-operations">
    <span>OPERATIONS</span>
    <div>
      <span>Orchestration</span>
      <span>Observability</span>
      <span>Immutable releases</span>
    </div>
  </div>
</figure>

<style>
  .project-workflow {
    position: relative;
    overflow: hidden;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 80% 15%, rgba(82, 105, 217, 0.17), transparent 32%), #111611;
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto;
    padding: clamp(1rem, 3vw, 1.6rem);
    color: var(--dark-text);
  }

  .workflow-track {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.2rem);
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.3rem) 0;
    list-style: none;
  }

  .workflow-track li {
    position: relative;
    min-width: 0;
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-sm);
    background: rgba(22, 28, 22, 0.94);
    padding: clamp(0.7rem, 1.5vw, 1rem);
  }

  .workflow-track li:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: calc(clamp(0.75rem, 1.5vw, 1.2rem) * -1);
    width: clamp(0.75rem, 1.5vw, 1.2rem);
    height: 1px;
    background: #6177d8;
    content: "→";
    color: #8da2ff;
    font-size: 0.6rem;
    line-height: 0;
    text-align: center;
  }

  .workflow-number {
    display: block;
    margin-bottom: 1.8rem;
    color: #718bf1;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .workflow-track small,
  .workflow-operations > span {
    display: block;
    color: #7f877b;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 640;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .workflow-track strong {
    display: block;
    margin-top: 0.3rem;
    color: #f1f3ec;
    font-size: clamp(0.72rem, 1.3vw, 0.88rem);
    font-weight: 580;
  }

  .workflow-track p {
    margin: 0.35rem 0 0;
    color: var(--dark-soft);
    font-size: clamp(0.58rem, 1.1vw, 0.7rem);
    line-height: 1.4;
  }

  .workflow-operations {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--dark-border);
    padding-top: 1rem;
  }

  .workflow-operations > div {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .workflow-operations > div span {
    border: 1px solid #303930;
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: #9da59a;
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  @media (max-width: 40rem) {
    .workflow-track {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding-block: 1.25rem;
    }

    .workflow-track li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.1rem 0.65rem;
    }

    .workflow-track li:not(:last-child)::after {
      top: auto;
      right: auto;
      bottom: -0.65rem;
      left: 1.65rem;
      width: 1px;
      height: 0.65rem;
      line-height: 0.65rem;
      writing-mode: vertical-rl;
    }

    .workflow-number {
      grid-row: 1 / 4;
      margin: 0;
    }

    .workflow-track small,
    .workflow-track strong,
    .workflow-track p {
      grid-column: 2;
    }

    .workflow-operations {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .workflow-operations > div {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }
</style>
