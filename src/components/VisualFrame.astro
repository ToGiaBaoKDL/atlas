<div class="visual-frame">
  <slot />
</div>

<style>
  .visual-frame {
    min-width: 0;
  }

  @media (max-width: 40rem) {
    .visual-frame {
      --visual-frame-scale: 0.64;

      overflow: hidden;
    }

    .visual-frame {
      aspect-ratio: 1.59;
    }

    .visual-frame > :global(*) {
      width: calc(100% / var(--visual-frame-scale));
      max-width: none;
      transform: scale(var(--visual-frame-scale));
      transform-origin: top left;
    }
  }
</style>
