---
import VisualFrame from "./VisualFrame.astro";
import VisualHeader from "./VisualHeader.astro";

interface Props {
  eyebrow: string;
  title: string;
  status: string;
  caption: string;
  number: string;
}

const { eyebrow, title, status, caption, number } = Astro.props;
---

<figure class="technical-figure" data-reveal>
  <VisualFrame aspect="landscape" presentation="detail">
    <div class="technical-figure-panel">
      <VisualHeader {eyebrow} {title} {status} />
      <div class="technical-figure-canvas">
        <slot />
      </div>
    </div>
  </VisualFrame>
  <figcaption>
    <span>{number}</span>
    <p>{caption}</p>
  </figcaption>
</figure>

<style>
  .technical-figure {
    width: 100%;
    margin: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .technical-figure-panel {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: var(--visual-canvas-ratio, auto);
    grid-template-rows: auto minmax(0, 1fr);
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 82% 12%, rgba(163, 230, 53, 0.1), transparent 30%),
      radial-gradient(circle at 14% 88%, rgba(163, 230, 53, 0.06), transparent 28%),
      var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto,
      auto;
    padding: clamp(0.9rem, 1.6vw, 1.15rem);
    color: var(--visual-text);
  }

  .technical-figure-canvas {
    min-height: 0;
    padding-top: clamp(0.65rem, 1.4vw, 0.85rem);
  }

  /* Prose rhythm must not alter the geometry of embedded UI diagrams. */
  .technical-figure-canvas :global(li + li) {
    margin-top: 0;
  }

  figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin-top: 0.8rem;
  }

  figcaption span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  figcaption p {
    max-width: 42rem;
    margin: 0;
    color: var(--text-faint);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  @media (max-width: 40rem) {
    .technical-figure {
      margin-block: 2.5rem;
    }

    figcaption {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      margin-top: 0.65rem;
    }

    figcaption span {
      font-size: 0.58rem;
    }
  }
</style>
