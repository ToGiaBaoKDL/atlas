---
import { ui } from "../data/site";
---

<button
  class="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label={ui.themeToggle}
  data-theme-toggle
>
  <span class="track" aria-hidden="true">
    <span class="thumb">
      <svg
        class="sun"
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="3.5"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
        ></path>
      </svg>
      <svg
        class="moon"
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M20.5 15.4A8.6 8.6 0 0 1 8.6 3.5 8.7 8.7 0 1 0 20.5 15.4Z"></path>
      </svg>
    </span>
  </span>
</button>

<script>
  const themeToggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const systemTheme = matchMedia("(prefers-color-scheme: dark)");
  let hasSessionSelection = false;

  const hasSavedTheme = () => {
    try {
      const savedTheme = localStorage.getItem("theme");
      return savedTheme === "light" || savedTheme === "dark";
    } catch {
      return false;
    }
  };

  const syncThemeControls = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    themeToggles.forEach((toggle) => toggle.setAttribute("aria-checked", String(isDark)));
    const themeColor = document.querySelector<HTMLMetaElement>("[data-theme-color]");
    const color = isDark ? themeColor?.dataset.dark : themeColor?.dataset.light;
    if (themeColor && color) themeColor.content = color;
  };

  syncThemeControls();

  themeToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      hasSessionSelection = true;
      document.documentElement.dataset.theme = nextTheme;
      syncThemeControls();

      try {
        localStorage.setItem("theme", nextTheme);
      } catch {
        // The selected theme still applies when storage is unavailable.
      }
    });
  });

  systemTheme.addEventListener("change", (event) => {
    if (hasSessionSelection || hasSavedTheme()) return;
    document.documentElement.dataset.theme = event.matches ? "dark" : "light";
    syncThemeControls();
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-soft);
    cursor: pointer;
  }

  .track {
    position: relative;
    width: 2.65rem;
    height: 1.45rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .thumb {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    display: grid;
    width: 1.05rem;
    height: 1.05rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-elevated);
    box-shadow: 0 0.12rem 0.35rem rgba(15, 18, 14, 0.2);
    color: var(--text);
    transition:
      transform var(--motion-base) var(--ease-out),
      background-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .sun,
  .moon {
    grid-area: 1 / 1;
  }

  .moon,
  .theme-toggle[aria-checked="true"] .sun {
    display: none;
  }

  .theme-toggle:hover .track,
  .theme-toggle[aria-checked="true"] .track {
    border-color: var(--accent);
  }

  .theme-toggle[aria-checked="true"] .track {
    background: color-mix(in srgb, var(--accent) 30%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .theme-toggle[aria-checked="true"] .thumb {
    transform: translateX(1.2rem);
    background: var(--accent);
    box-shadow:
      0 0 0 0.16rem color-mix(in srgb, var(--accent) 22%, transparent),
      0 0.16rem 0.45rem rgba(0, 0, 0, 0.28);
    color: var(--on-accent);
  }

  .theme-toggle[aria-checked="true"] .moon {
    display: block;
  }

  .theme-toggle[aria-checked="true"]:hover .thumb {
    background: var(--accent-hover);
  }
</style>
