---
import { site, ui } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">© {year} {site.name}. {ui.footer}</p>
    <nav class="footer-links" aria-label="Social links">
      <a href={site.github} rel="me">GitHub ↗</a>
      <a href={site.linkedin} rel="me">LinkedIn ↗</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.resume} target="_blank" rel="noopener">Resume ↗</a>
    </nav>
  </div>
</footer>
