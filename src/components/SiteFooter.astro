---
import { localizedPath, site, ui, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">© {year} {site.name}. {copy.footer}</p>
    <nav
      class="footer-links"
      aria-label={locale === "en" ? "Social and resources" : "Liên kết và tài nguyên"}
    >
      <a href={site.github} rel="me">GitHub ↗</a>
      <a href={site.linkedin} rel="me">LinkedIn ↗</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.resume}>Resume</a>
      <a href={locale === "en" ? "/rss.xml" : "/vi/rss.xml"}>RSS</a>
      <a href={localizedPath(locale, "about")}>{copy.nav.about}</a>
    </nav>
  </div>
</footer>
