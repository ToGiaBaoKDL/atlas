---
import { getProjects } from "../data/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import ProjectCard from "./ProjectCard.astro";

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Personal systems and technical case studies, presented through constraints, decisions and trade-offs."
  section="projects"
>
  <div class="container">
    <PageHero
      kicker="Selected systems"
      title="Projects"
      description="Personal systems and technical case studies, presented through constraints, decisions and trade-offs."
    />

    <section class="projects-list" aria-label="Projects">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} index={index} variant="list" />
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .projects-list {
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 40rem) {
    .projects-list {
      display: grid;
      gap: 1rem;
      border-top: 0;
    }
  }
</style>
