---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="About"
  description="About Tô Gia Bảo, a Data Engineer focused on reliable data platforms, analytics systems and AI-assisted tools."
  section="about"
>
  <div class="container">
    <header class="page-hero">
      <p class="section-kicker">About</p>
      <h1>Engineer, builder, lifelong learner.</h1>
    </header>

    <div class="about-grid">
      <div class="about-copy">
        <p>
          I'm Tô Gia Bảo, a Data Engineer at Timo Digital Bank by BVBank. I build cloud data
          pipelines, orchestration workflows, analytics systems and AI-assisted tools using Python,
          SQL, AWS, Airflow and dbt.
        </p>
        <p>
          I care about explicit system boundaries, observable operations and designs that remain
          understandable as they grow. My current interests include lakehouse architecture,
          infrastructure as code and AI-native data tooling.
        </p>
        <p>I hold a B.Sc. in Data Science from the University of Science, VNU-HCM.</p>

        <a
          class="resume-preview"
          href={site.resume}
          target="_blank"
          rel="noopener"
          aria-label="View Tô Gia Bảo's full resume in a new tab"
        >
          <img
            src="/resume/togia-bao-resume-preview.png"
            alt="Preview of Tô Gia Bảo's resume"
            loading="lazy"
            width="708"
            height="1000"
          />
          <span>
            <small>RESUME · PDF</small>
            <strong>View full resume</strong>
            <i aria-hidden="true">↗</i>
          </span>
        </a>
      </div>

      <aside class="about-details" aria-label="Profile details">
        <section>
          <h2>Current role</h2>
          <p>Data Engineer · Timo Digital Bank by BVBank</p>
        </section>
        <section>
          <h2>Location</h2>
          <p>Ho Chi Minh City, Vietnam</p>
        </section>
        <section>
          <h2>Current focus</h2>
          <p>Data platforms · Lakehouse · Cloud infrastructure · Applied AI</p>
        </section>
        <section>
          <h2>Email</h2>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
