---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experiences } from "../data/experience";
import { site } from "../data/site";
import PageHero from "./PageHero.astro";
---

<BaseLayout
  title="About"
  description="About Tô Gia Bảo, a Data Engineer focused on reliable data platforms, analytics systems and AI-assisted tools."
  section="about"
>
  <div class="container">
    <PageHero kicker="About" title="Engineer, builder, lifelong learner." />

    <div class="about-grid" data-reveal>
      <div class="about-copy">
        <p>
          I'm {site.name}, a {site.role} at {site.employer}. I build cloud data pipelines,
          orchestration workflows, analytics systems and AI-assisted tools using Python, SQL, AWS,
          Airflow and dbt.
        </p>
        <p>
          I care about explicit system boundaries, observable operations and designs that remain
          understandable as they grow. My current interests include lakehouse architecture,
          infrastructure as code and AI-native data tooling.
        </p>

        <section class="experience" aria-labelledby="experience-heading">
          <p class="section-kicker">Experience</p>
          <h2 id="experience-heading">Professional experience</h2>
          {
            experiences.map((experience) => (
              <article class="experience-role">
                <header>
                  <div>
                    <h3>{experience.company}</h3>
                    <p>{experience.role}</p>
                  </div>
                  <p class="experience-period">
                    <time datetime={experience.startDate}>{experience.startLabel}</time> — Present
                  </p>
                </header>
                <p class="experience-summary">{experience.summary}</p>
                <ul>
                  {experience.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </section>

        <a
          class="resume-preview"
          href={site.resume}
          target="_blank"
          rel="noopener"
          aria-label="View Tô Gia Bảo's full resume in a new tab"
        >
          <img
            src="/resume/togia-bao-resume-preview.png"
            alt="Preview of Tô Gia Bảo's resume"
            loading="lazy"
            width="708"
            height="1000"
          />
          <span>
            <small>RESUME · PDF</small>
            <strong>View full resume</strong>
            <i aria-hidden="true">↗</i>
          </span>
        </a>
      </div>

      <aside class="about-details" aria-label="Profile details">
        <section>
          <h2>Location</h2>
          <p>Ho Chi Minh City, Vietnam</p>
        </section>
        <section>
          <h2>Current focus</h2>
          <p>Data platforms · Lakehouse · Cloud infrastructure · Applied AI</p>
        </section>
        <section>
          <h2>Education</h2>
          <p>B.Sc. Data Science · University of Science, VNU-HCM</p>
        </section>
        <section>
          <h2>Email</h2>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.55fr);
    gap: clamp(3rem, 9vw, 8rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .about-copy {
    max-width: var(--article-width);
  }

  .about-copy > p {
    margin: 0 0 1.35rem;
    color: var(--text-soft);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
  }

  .about-copy > p:first-child {
    color: var(--text);
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    letter-spacing: -0.025em;
  }

  .resume-preview {
    display: block;
    max-width: 28rem;
    margin-top: 3.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition:
      transform var(--motion-base) var(--ease-out),
      border-color var(--motion-fast) ease;
  }

  .resume-preview:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .resume-preview img {
    width: 100%;
    max-height: 31rem;
    border-bottom: 1px solid var(--border);
    object-fit: cover;
    object-position: top;
  }

  .resume-preview > span {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: center;
    padding: 1rem;
  }

  .resume-preview small {
    grid-column: 1;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 630;
    letter-spacing: 0.08em;
  }

  .resume-preview strong {
    grid-column: 1;
    font-size: 0.95rem;
    font-weight: 610;
  }

  .resume-preview i {
    grid-row: 1 / 3;
    grid-column: 2;
    color: var(--accent);
    font-size: 1.15rem;
    font-style: normal;
  }

  .about-details {
    border-top: 1px solid var(--border);
  }

  .about-details section {
    border-bottom: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .about-details h2 {
    margin: 0 0 0.5rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-details p {
    margin: 0;
    font-size: 0.92rem;
  }

  .experience {
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .experience > h2 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 630;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .experience-role {
    margin-top: 2rem;
  }

  .experience-role header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .experience-role h3,
  .experience-role header p {
    margin: 0;
  }

  .experience-role h3 {
    font-size: 1.08rem;
    font-weight: 630;
  }

  .experience-role header div > p,
  .experience-period {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .experience-period {
    flex: 0 0 auto;
    text-align: right;
  }

  .about-copy .experience-summary {
    margin: 1.25rem 0 0;
    color: var(--text);
    font-size: 1rem;
  }

  .experience-role ul {
    margin: 1.25rem 0 0;
    padding-left: 1.15rem;
  }

  .experience-role li {
    color: var(--text-soft);
  }

  .experience-role li + li {
    margin-top: 0.75rem;
  }

  .experience-role li::marker {
    color: var(--accent);
  }

  @media (max-width: 56rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .experience-role header {
      display: grid;
      gap: 0.55rem;
    }

    .experience-period {
      text-align: left;
    }
  }
</style>
