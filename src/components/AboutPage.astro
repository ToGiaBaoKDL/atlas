---
import BaseLayout from "../layouts/BaseLayout.astro";
import { alternateLocale, localizedPath, site, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const otherLocale = alternateLocale(locale);
const copy =
  locale === "en"
    ? {
        kicker: "About",
        title: "Engineer, builder, lifelong learner.",
        description:
          "About Tô Gia Bảo, a Data Engineer focused on reliable data platforms, analytics systems and AI-assisted tools.",
        paragraphs: [
          "I'm Tô Gia Bảo, a Data Engineer at Timo Digital Bank by BVBank. I build cloud data pipelines, orchestration workflows, analytics systems and AI-assisted tools using Python, SQL, AWS, Airflow and dbt.",
          "I care about explicit system boundaries, observable operations and designs that remain understandable as they grow. My current interests include lakehouse architecture, infrastructure as code and AI-native data tooling.",
          "I hold a B.Sc. in Data Science from the University of Science, VNU-HCM.",
        ],
        role: "Current role",
        roleValue: "Data Engineer · Timo Digital Bank by BVBank",
        location: "Location",
        locationValue: "Ho Chi Minh City, Vietnam",
        focus: "Current focus",
        focusValue: "Data platforms · Lakehouse · Cloud infrastructure · Applied AI",
        contact: "Contact",
        resume: "Download resume",
      }
    : {
        kicker: "Giới thiệu",
        title: "Kỹ sư, người xây dựng, người học suốt đời.",
        description:
          "Giới thiệu Tô Gia Bảo, Data Engineer tập trung vào nền tảng dữ liệu tin cậy, hệ thống phân tích và công cụ hỗ trợ bởi AI.",
        paragraphs: [
          "Tôi là Tô Gia Bảo, hiện làm Data Engineer tại Timo Digital Bank by BVBank. Tôi xây dựng pipeline dữ liệu trên cloud, workflow điều phối, hệ thống phân tích và các công cụ hỗ trợ bởi AI với Python, SQL, AWS, Airflow và dbt.",
          "Tôi chú trọng ranh giới hệ thống rõ ràng, khả năng quan sát khi vận hành và những thiết kế vẫn dễ hiểu khi mở rộng. Các hướng tôi đang quan tâm gồm kiến trúc lakehouse, infrastructure as code và công cụ dữ liệu AI-native.",
          "Tôi tốt nghiệp Cử nhân Khoa học Dữ liệu tại Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM.",
        ],
        role: "Vai trò hiện tại",
        roleValue: "Data Engineer · Timo Digital Bank by BVBank",
        location: "Địa điểm",
        locationValue: "TP. Hồ Chí Minh, Việt Nam",
        focus: "Hướng quan tâm",
        focusValue: "Nền tảng dữ liệu · Lakehouse · Hạ tầng Cloud · AI ứng dụng",
        contact: "Liên hệ",
        resume: "Tải resume",
      };
---

<BaseLayout
  locale={locale}
  title={copy.kicker}
  description={copy.description}
  section="about"
  alternatePath={localizedPath(otherLocale, "about")}
>
  <div class="container">
    <header class="page-hero">
      <p class="section-kicker">{copy.kicker}</p>
      <h1>{copy.title}</h1>
    </header>

    <div class="about-grid">
      <div class="about-copy">
        {copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="button-row">
          <a class="button" href={`mailto:${site.email}`}>{copy.contact}</a>
          <a class="button button-secondary" href={site.resume}>{copy.resume} ↓</a>
        </div>
      </div>
      <aside
        class="about-details"
        aria-label={locale === "en" ? "Profile details" : "Thông tin hồ sơ"}
      >
        <section>
          <h2>{copy.role}</h2>
          <p>{copy.roleValue}</p>
        </section>
        <section>
          <h2>{copy.location}</h2>
          <p>{copy.locationValue}</p>
        </section>
        <section>
          <h2>{copy.focus}</h2>
          <p>{copy.focusValue}</p>
        </section>
        <section>
          <h2>Email</h2>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
