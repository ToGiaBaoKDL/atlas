---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjectStatusLabel } from "../data/projects";
import PageHero from "./PageHero.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Personal systems and technical case studies, presented through constraints, decisions and trade-offs."
  section="work"
>
  <div class="container">
    <PageHero
      kicker="Selected systems"
      title="Work"
      description="Personal systems and technical case studies, presented through constraints, decisions and trade-offs."
    />

    <section class="work-list" aria-label="Work">
      {
        projects.map((project, index) => (
          <a class="work-list-item" href={`/work/${project.id}/`}>
            <span class="work-list-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{project.data.title}</h2>
              <p class="work-list-meta">
                {project.data.role} · {getProjectStatusLabel(project.data.status)}
              </p>
              <p>{project.data.outcome}</p>
            </div>
            <span class="work-list-stack" aria-label="Technology stack">
              {project.data.stack.join(" · ")}
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .work-list {
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--border);
  }

  .work-list-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(12rem, 0.65fr) auto;
    gap: 1.5rem;
    align-items: start;
    border-bottom: 1px solid var(--border);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    text-decoration: none;
  }

  .work-list-item:hover h2 {
    color: var(--accent);
  }

  .work-list-number {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .work-list-item h2 {
    margin: 0 0 0.55rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 610;
    letter-spacing: -0.035em;
    line-height: 1.1;
    transition: color 160ms ease;
  }

  .work-list-item p {
    margin: 0;
    color: var(--text-soft);
  }

  .work-list-item .work-list-meta {
    margin-bottom: 0.55rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 560;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .work-list-stack {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.8;
  }

  @media (max-width: 56rem) {
    .work-list-item {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .work-list-stack {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .work-list-item {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .work-list-item p {
      font-size: 0.88rem;
    }
  }
</style>
