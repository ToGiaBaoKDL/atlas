---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Personal systems and technical case studies, presented through constraints, decisions and trade-offs."
  section="work"
>
  <div class="container">
    <header class="page-hero">
      <p class="section-kicker">Selected systems</p>
      <h1>Work</h1>
      <p>
        Personal systems and technical case studies, presented through constraints, decisions and
        trade-offs.
      </p>
    </header>

    <section class="work-list" aria-label="Work">
      {
        projects.map((project, index) => (
          <a class="work-list-item" href={`/work/${project.data.slug}/`}>
            <span class="work-list-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{project.data.title}</h2>
              <p>{project.data.outcome}</p>
            </div>
            <span class="work-list-stack" aria-label="Role, period and stack">
              {project.data.stack.join(" · ")}
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </section>
  </div>
  <div class="section"></div>
</BaseLayout>
