---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects, getPublishedWriting } from "../data/content";
import { getProjectStatusLabel } from "../data/projects";
import { site } from "../data/site";
import { writingTopics } from "../data/topics";
import ProjectVisual from "./ProjectVisual.astro";
import SignatureVisual from "./SignatureVisual.astro";
import WritingList from "./WritingList.astro";

const projects = await getProjects();
const homepageProjects = projects.slice(0, 3);
const writing = (await getPublishedWriting()).slice(0, 3);
---

<BaseLayout
  title={site.name}
  description={`${site.name} is a ${site.role} building reliable data platforms, lakehouse systems and AI-powered data products.`}
>
  <div class="container hero">
    <div class="hero-copy" data-enter>
      <p class="eyebrow">{site.role} · Data Platforms</p>
      <h1>I build reliable data platforms, end to end.</h1>
      <p class="hero-lead">
        I'm {site.name}, a {site.role} at {site.employer}. I work across ingestion, orchestration,
        lakehouse architecture, analytics engineering and AI-powered data products.
      </p>
      <div class="button-row">
        <a class="button" href="#selected-projects"
          >Explore projects <span aria-hidden="true">→</span></a
        >
        <a class="button button-secondary" href="/about/">About me</a>
      </div>
      <ul class="focus-strip" aria-label="Current focus">
        <li>Data Platforms</li>
        <li>Lakehouse Architecture</li>
        <li>Cloud Infrastructure</li>
      </ul>
    </div>
    <div class="hero-visual" data-enter="delayed">
      <SignatureVisual />
    </div>
  </div>

  <section class="projects-band section" id="selected-projects">
    <div class="container">
      <div class="section-heading" data-project-heading>
        <div>
          <p class="section-kicker">I / Projects</p>
          <h2>Selected projects</h2>
        </div>
        <a class="text-link" href="/projects/">View all projects →</a>
      </div>

      <div class="project-stack">
        {
          homepageProjects.map((project, index) => (
            <article
              class:list={["project-showcase", { "project-showcase-reverse": index % 2 === 1 }]}
              data-reveal
              data-reveal-delay={String(Math.min(index, 2))}
            >
              <div class="project-copy">
                <span class="project-index">
                  {String(index + 1).padStart(2, "0")} · {project.data.role} ·{" "}
                  {getProjectStatusLabel(project.data.status)}
                </span>
                <h3>{project.data.title}</h3>
                <p>{project.data.outcome}</p>
                <ul class="tag-list" aria-label="Technology stack">
                  {project.data.stack.slice(0, 5).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <a class="text-link" href={`/projects/${project.id}/`}>
                  Read case study <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="project-showcase-visual">
                <ProjectVisual projectId={project.id} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="writing-section section">
    <div class="container writing-grid" data-reveal>
      <div class="writing-intro">
        <p class="section-kicker">II / Writing</p>
        <h2>Ideas worth unpacking.</h2>
        <p>
          Notes and essays on data systems, software design, cloud infrastructure, applied AI and
          other technical questions worth exploring.
        </p>
        <a class="text-link" href="/writing/">Explore writing →</a>
      </div>
      {
        writing.length > 0 ? (
          <WritingList entries={writing} headingLevel="h3" />
        ) : (
          <ul class="topic-list">
            {writingTopics.map((topic) => (
              <li>
                <span>{topic.label}</span>
                <code>{topic.slug}</code>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const projectHeading = document.querySelector<HTMLElement>("[data-project-heading]");
  const lastProject = document.querySelector<HTMLElement>(
    ".project-stack > .project-showcase:last-of-type",
  );

  if (projectHeading && lastProject && "IntersectionObserver" in window) {
    projectHeading.setAttribute("data-sticky-ready", "");

    const releaseObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio >= 0.98) {
          projectHeading.setAttribute("data-sticky-released", "");
          return;
        }

        const viewportBottom = entry.rootBounds?.bottom ?? window.innerHeight;
        if (entry.boundingClientRect.top >= viewportBottom) {
          projectHeading.removeAttribute("data-sticky-released");
        }
      },
      { threshold: [0, 0.98] },
    );

    releaseObserver.observe(lastProject);
  }
</script>

<style>
  .hero {
    display: grid;
    min-height: min(48rem, calc(100svh - var(--header-height)));
    grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.98fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-visual {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.25rem var(--accent-soft);
    content: "";
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.4vw, 5.8rem);
    font-weight: 690;
    letter-spacing: -0.067em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 39rem;
    margin: 1.75rem 0 2rem;
    color: var(--text-soft);
    font-size: clamp(1.04rem, 1.7vw, 1.18rem);
    line-height: 1.65;
  }

  .focus-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
    margin: 2rem 0 0;
    padding: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    list-style: none;
  }

  .focus-strip li:not(:last-child)::after {
    margin-left: 1.15rem;
    color: var(--border-strong);
    content: "/";
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .projects-band {
    background: var(--dark);
    color: var(--dark-text);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .projects-band .section-heading {
    border-color: var(--dark-border);
  }

  .projects-band .section-heading .text-link,
  .projects-band .section-kicker {
    color: var(--dark-soft);
  }

  .projects-band .section-heading .text-link:hover,
  .projects-band .section-heading .text-link:focus-visible,
  .project-showcase .text-link:hover,
  .project-showcase .text-link:focus-visible {
    color: var(--dark-accent);
  }

  .projects-band :focus-visible {
    outline-color: var(--dark-accent);
  }

  .project-stack {
    display: grid;
  }

  .project-showcase {
    display: grid;
    grid-template-columns: minmax(15rem, 0.76fr) minmax(0, 1.24fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-showcase + .project-showcase {
    border-top: 1px solid var(--dark-border);
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .project-showcase:last-child {
    padding-bottom: 0;
  }

  .project-showcase-reverse {
    grid-template-columns: minmax(0, 1.24fr) minmax(15rem, 0.76fr);
  }

  .project-showcase-reverse .project-copy {
    order: 2;
  }

  .project-index {
    display: block;
    margin-bottom: 2rem;
    color: var(--dark-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .project-showcase h3 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.7rem);
    font-weight: 610;
    letter-spacing: -0.052em;
    line-height: 1.02;
  }

  .project-showcase p {
    max-width: 34rem;
    margin: 1.25rem 0;
    color: var(--dark-soft);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    border: 1px solid var(--dark-border);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--dark-soft);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .project-showcase .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--dark-text);
  }

  .project-showcase-visual {
    min-width: 0;
  }

  .writing-section {
    padding-top: clamp(3.5rem, 6vw, 4.5rem);
  }

  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .writing-intro h2 {
    max-width: 13ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .writing-intro p {
    max-width: 31rem;
    color: var(--text-soft);
  }

  .topic-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-block: 0.9rem;
  }

  .topic-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .topic-list span {
    font-weight: 560;
  }

  .topic-list code {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .project-showcase,
    .project-showcase-reverse,
    .writing-grid {
      grid-template-columns: 1fr;
    }

    .project-showcase-reverse .project-copy {
      order: initial;
    }

    .project-showcase h3 {
      max-width: 18ch;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      gap: 2rem;
      padding-block: 3rem 4rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 14.5vw, 4.25rem);
      line-height: 0.98;
    }

    .hero-lead {
      margin-block: 1.4rem 1.6rem;
    }

    .focus-strip {
      display: none;
    }

    .section-heading {
      align-items: flex-end;
    }

    .project-showcase-visual {
      position: relative;
      overflow: hidden;
      max-height: 28rem;
      border-radius: var(--radius-md);
    }

    .project-showcase-visual::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 5rem;
      background: linear-gradient(transparent, var(--dark));
      content: "";
      pointer-events: none;
    }

    .topic-list li {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  @media (min-width: 56.001rem) and (min-height: 44rem) and (prefers-reduced-motion: no-preference) {
    .projects-band .section-heading[data-sticky-ready] {
      background: var(--dark);
      padding-top: 1rem;
    }

    .projects-band .section-heading[data-sticky-ready]:not([data-sticky-released]) {
      position: sticky;
      z-index: 3;
      top: var(--header-height);
    }

    .project-stack {
      --stack-card-height: 37rem;

      gap: clamp(3rem, 8vh, 5rem);
    }

    .project-stack::after {
      height: clamp(9rem, 32svh, 18rem);
      content: "";
    }

    .project-stack > .project-showcase {
      --stack-inset: 0rem;

      position: sticky;
      top: calc((100svh + var(--header-height) - var(--stack-card-height)) / 2);
      min-height: var(--stack-card-height);
      align-self: start;
      margin-inline: var(--stack-inset);
      border: 1px solid var(--dark-border);
      border-radius: calc(var(--radius-md) + 0.2rem);
      background: color-mix(in srgb, var(--dark) 96%, var(--dark-text));
      box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.3);
      padding: clamp(1.75rem, 3vw, 2.5rem);
    }

    .project-showcase + .project-showcase {
      --stack-inset: 0.75rem;
    }

    .project-showcase + .project-showcase + .project-showcase {
      --stack-inset: 1.5rem;
    }
  }
</style>
