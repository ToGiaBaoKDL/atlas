---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { topics } from "../data/topics";
import ProjectTopology from "./ProjectTopology.astro";
import SignatureVisual from "./SignatureVisual.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find(({ data }) => data.featured);
const secondary = projects.filter(({ data }) => !data.featured).slice(0, 2);

if (!featured) throw new Error("Missing featured project");
---

<BaseLayout
  title={site.name}
  description="Tô Gia Bảo is a Data Engineer building reliable data platforms, lakehouse systems and AI-powered data products."
>
  <div class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">Data Engineer · Data Platforms</p>
      <h1>I build reliable data platforms, end to end.</h1>
      <p class="hero-lead">
        I'm Tô Gia Bảo, a Data Engineer at Timo Digital Bank. I work across ingestion,
        orchestration, lakehouse architecture, analytics engineering and AI-powered data products.
      </p>
      <div class="button-row">
        <a class="button" href="#selected-work"
          >Explore selected work <span aria-hidden="true">→</span></a
        >
        <a class="button button-secondary" href="/notes/">Read my notes</a>
      </div>
      <ul class="focus-strip" aria-label="Current focus">
        <li>Data Platforms</li>
        <li>Lakehouse Architecture</li>
        <li>Cloud Infrastructure</li>
      </ul>
    </div>
    <SignatureVisual />
  </div>

  <section class="work-band section" id="selected-work">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Work</p>
          <h2>Selected work</h2>
        </div>
        <a class="text-link" href="/work/">View all work →</a>
      </div>

      <article class="featured-project">
        <div>
          <span class="project-index">01 · Sole designer & engineer</span>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.outcome}</p>
          <ul class="tag-list" aria-label="Technology stack">
            {featured.data.stack.slice(0, 5).map((item) => <li>{item}</li>)}
          </ul>
          <a class="text-link" href={`/work/${featured.data.slug}/`}>
            Read case study <span aria-hidden="true">→</span>
          </a>
        </div>
        <ProjectTopology />
      </article>

      {
        secondary.map((project, index) => (
          <a class="secondary-project" href={`/work/${project.data.slug}/`}>
            <span>{String(index + 2).padStart(2, "0")}</span>
            <h3>{project.data.title}</h3>
            <p>{project.data.outcome}</p>
            <span class="project-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container knowledge-grid">
      <div class="knowledge-intro">
        <p class="section-kicker">02 / Knowledge</p>
        <h2>Engineering notes, built in public.</h2>
        <p>
          I document the decisions behind the systems I build—from table ownership and idempotency
          to delivery boundaries and typed AI workflows.
        </p>
        <a class="text-link" href="/notes/">Browse notes →</a>
      </div>
      <ul class="topic-list">
        {
          topics.map((topic, index) => (
            <li>
              <span>{topic.label}</span>
              <code>topic/{String(index + 1).padStart(2, "0")}</code>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: min(48rem, calc(100svh - var(--header-height)));
    grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.98fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.25rem var(--accent-soft);
    content: "";
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.4vw, 5.8rem);
    font-weight: 690;
    letter-spacing: -0.067em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 39rem;
    margin: 1.75rem 0 2rem;
    color: var(--text-soft);
    font-size: clamp(1.04rem, 1.7vw, 1.18rem);
    line-height: 1.65;
  }

  .focus-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
    margin: 2rem 0 0;
    padding: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    list-style: none;
  }

  .focus-strip li:not(:last-child)::after {
    margin-left: 1.15rem;
    color: var(--border-strong);
    content: "/";
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .work-band {
    background: var(--dark);
    color: var(--dark-text);
  }

  .work-band .section-heading {
    border-color: var(--dark-border);
  }

  .work-band .section-heading .text-link,
  .work-band .section-kicker {
    color: var(--dark-soft);
  }

  .featured-project {
    display: grid;
    grid-template-columns: minmax(15rem, 0.76fr) minmax(0, 1.24fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-index {
    display: block;
    margin-bottom: 2rem;
    color: var(--dark-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .featured-project h3 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.7rem);
    font-weight: 610;
    letter-spacing: -0.052em;
    line-height: 1.02;
  }

  .featured-project p {
    max-width: 34rem;
    margin: 1.25rem 0;
    color: var(--dark-soft);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    border: 1px solid var(--dark-border);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--dark-soft);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .featured-project .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--dark-text);
  }

  .secondary-project {
    display: grid;
    grid-template-columns: 3rem minmax(14rem, 0.9fr) minmax(14rem, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    border-top: 1px solid var(--dark-border);
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .secondary-project:last-child {
    border-bottom: 1px solid var(--dark-border);
  }

  .secondary-project:hover h3,
  .secondary-project:hover .project-arrow {
    color: #9eafff;
  }

  .secondary-project > span:first-child {
    color: var(--dark-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .secondary-project h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 580;
    transition: color 160ms ease;
  }

  .secondary-project p {
    margin: 0;
    color: var(--dark-soft);
    font-size: 0.86rem;
  }

  .project-arrow {
    transition: color 160ms ease;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .knowledge-intro h2 {
    max-width: 13ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .knowledge-intro p {
    max-width: 31rem;
    color: var(--text-soft);
  }

  .topic-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-block: 0.9rem;
  }

  .topic-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .topic-list span {
    font-weight: 560;
  }

  .topic-list code {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .featured-project,
    .knowledge-grid {
      grid-template-columns: 1fr;
    }

    .featured-project h3 {
      max-width: 18ch;
    }

    .secondary-project {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .secondary-project p {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      gap: 2.75rem;
      padding-block: 3.5rem 4rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 14.5vw, 4.25rem);
      line-height: 0.98;
    }

    .hero-lead {
      margin-block: 1.4rem 1.6rem;
    }

    .focus-strip {
      display: grid;
      gap: 0.35rem;
    }

    .focus-strip li::after {
      display: none;
    }

    .section-heading {
      align-items: flex-end;
    }

    .secondary-project {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }
  }
</style>
