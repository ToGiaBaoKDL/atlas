---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects, getPublishedWritingSeries } from "../data/content";
import { featuredWritingSeries } from "../data/series";
import { site } from "../data/site";
import ProjectCard from "./ProjectCard.astro";
import SignatureVisual from "./SignatureVisual.astro";
import VisualFrame from "./VisualFrame.astro";
import WritingList from "./WritingList.astro";

const projects = await getProjects();
const homepageProjects = projects.slice(0, 3);
const {
  series: featuredSeries,
  entries: featuredWriting,
  isComplete: featuredSeriesComplete,
} = await getPublishedWritingSeries(featuredWritingSeries.id);
const featuredStart = featuredWriting[0];
---

<BaseLayout
  title={site.name}
  description={`${site.name} is a ${site.role} building reliable data platforms, lakehouse systems and AI-powered data products.`}
>
  <div class="container hero">
    <div class="hero-copy" data-enter>
      <p class="eyebrow">{site.role} · Data Platforms</p>
      <h1>I build reliable data platforms, end to end.</h1>
      <p class="hero-lead">
        I'm {site.name}, a {site.role} at {site.employer}. I work across ingestion, orchestration,
        lakehouse architecture, analytics engineering and AI-powered data products.
      </p>
      <div class="button-row">
        <a class="button" href="#selected-projects"
          >Explore projects <span aria-hidden="true">→</span></a
        >
        <a class="button button-secondary" href="/about/">About me</a>
      </div>
      <ul class="focus-strip" aria-label="Current focus">
        <li>Data Platforms</li>
        <li>Lakehouse Architecture</li>
        <li>Cloud Infrastructure</li>
      </ul>
    </div>
    <div class="hero-visual" data-enter="delayed">
      <VisualFrame>
        <SignatureVisual />
      </VisualFrame>
    </div>
  </div>

  <section class="projects-band section" id="selected-projects">
    <div class="container">
      <div class="section-heading" data-project-heading>
        <div>
          <p class="section-kicker">I / Projects</p>
          <h2>Selected projects</h2>
        </div>
        <a class="text-link" href="/projects/">View all projects →</a>
      </div>

      <div class="project-stack">
        {
          homepageProjects.map((project, index) => (
            <ProjectCard project={project} index={index} variant="showcase" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="writing-section section">
    <div class="container writing-grid" data-reveal>
      <div class="writing-intro">
        <p class="section-kicker">II / Writing</p>
        <h2>{featuredSeries.name}.</h2>
        <p>{featuredSeries.description}</p>
        <p class="series-meta">
          {featuredSeriesComplete ? "Complete series" : "Series"} · {featuredSeries.totalParts} parts
        </p>
        <a class="text-link" href={featuredStart ? `/writing/${featuredStart.id}/` : "/writing/"}>
          {featuredStart ? "Start with part 01" : "Explore writing"} →
        </a>
      </div>
      {featuredWriting.length > 0 && <WritingList entries={featuredWriting} headingLevel="h3" />}
    </div>
  </section>
</BaseLayout>

<script>
  const projectHeading = document.querySelector<HTMLElement>("[data-project-heading]");
  const writingBoundary = document.querySelector<HTMLElement>(".writing-section");
  const projectsBand = projectHeading?.closest<HTMLElement>(".projects-band");

  if (projectHeading && projectsBand) {
    projectHeading.setAttribute("data-sticky-ready", "");
    let boundaryObserver: IntersectionObserver | undefined;

    const syncStickyLayout = () => {
      projectsBand.style.setProperty(
        "--project-heading-height",
        `${projectHeading.offsetHeight}px`,
      );

      if (!writingBoundary || !("IntersectionObserver" in window)) return;

      const rootMargin = getComputedStyle(projectsBand)
        .getPropertyValue("--project-heading-release-margin")
        .trim();

      if (boundaryObserver?.rootMargin === rootMargin) return;

      boundaryObserver?.disconnect();
      boundaryObserver = new IntersectionObserver(
        ([entry]) => {
          projectHeading.toggleAttribute("data-sticky-hidden", entry.isIntersecting);
          projectHeading.toggleAttribute("inert", entry.isIntersecting);
        },
        { rootMargin, threshold: 0 },
      );
      boundaryObserver.observe(writingBoundary);
    };

    syncStickyLayout();

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(syncStickyLayout);
      resizeObserver.observe(projectHeading);
      resizeObserver.observe(projectsBand);
    }
  }
</script>

<style>
  .hero {
    display: grid;
    min-height: min(48rem, calc(100svh - var(--header-height)));
    grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.98fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-visual {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.25rem var(--accent-soft);
    content: "";
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.4vw, 5.8rem);
    font-weight: 690;
    letter-spacing: -0.067em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 39rem;
    margin: 1.75rem 0 2rem;
    color: var(--text-soft);
    font-size: clamp(1.04rem, 1.7vw, 1.18rem);
    line-height: 1.65;
  }

  .focus-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
    margin: 2rem 0 0;
    padding: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    list-style: none;
  }

  .focus-strip li:not(:last-child)::after {
    margin-left: 1.15rem;
    color: var(--border-strong);
    content: "/";
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .projects-band {
    --project-heading-height: 0px;
    --project-heading-release-margin: 0px 0px -1px 0px;

    background: var(--dark);
    color: var(--dark-text);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .projects-band .section-heading {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
    border-color: var(--dark-border);
  }

  .projects-band .section-heading .text-link,
  .projects-band .section-kicker {
    color: var(--dark-soft);
  }

  .projects-band .section-heading .text-link:hover,
  .projects-band .section-heading .text-link:focus-visible {
    color: var(--dark-accent);
  }

  .projects-band :focus-visible {
    outline-color: var(--dark-accent);
  }

  .project-stack {
    display: grid;
  }

  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .writing-intro h2 {
    max-width: 13ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .writing-intro p {
    max-width: 31rem;
    color: var(--text-soft);
  }

  .writing-intro .series-meta {
    margin-block: 1.5rem 0.8rem;
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .writing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      gap: 2rem;
      padding-block: 3rem 4rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 14.5vw, 4.25rem);
      line-height: 0.98;
    }

    .hero-lead {
      margin-block: 1.4rem 1.6rem;
    }

    .focus-strip {
      display: none;
    }

    .section-heading {
      align-items: flex-end;
    }

    .projects-band .section-heading {
      margin-bottom: 2rem;
    }

    .projects-band {
      --project-heading-release-margin: 0px 0px -35% 0px;
    }

    .project-stack {
      gap: 1rem;
    }
  }

  @media (max-width: 40rem) and (min-height: 46rem) and (prefers-reduced-motion: no-preference) {
    .projects-band {
      --sticky-heading-padding: 0.75rem;
      --sticky-heading-shift: -0.5rem;
      --sticky-heading-z: 4;
    }

    .project-stack {
      gap: 2rem;
    }

    .project-stack::after {
      height: clamp(7rem, 20svh, 10rem);
      content: "";
    }
  }

  @media (min-width: 56.001rem) and (min-height: 44rem) and (prefers-reduced-motion: no-preference) {
    .projects-band {
      --sticky-heading-padding: 1rem;
      --sticky-heading-shift: -0.75rem;
      --sticky-heading-z: 3;
    }

    .project-stack {
      gap: clamp(3rem, 8vh, 5rem);
    }

    .project-stack::after {
      height: clamp(9rem, 32svh, 18rem);
      content: "";
    }
  }

  @media (max-width: 40rem) and (min-height: 46rem) and (prefers-reduced-motion: no-preference),
    (min-width: 56.001rem) and (min-height: 44rem) and (prefers-reduced-motion: no-preference) {
    .projects-band .section-heading[data-sticky-ready] {
      position: sticky;
      z-index: var(--sticky-heading-z);
      top: var(--header-height);
      background: var(--dark);
      padding-top: var(--sticky-heading-padding);
      transition:
        transform var(--motion-base) var(--ease-out),
        opacity var(--motion-base) ease;
    }

    .projects-band .section-heading[data-sticky-hidden] {
      transform: translateY(var(--sticky-heading-shift));
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
