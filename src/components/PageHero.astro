---
interface Props {
  kicker: string;
  title: string;
  description?: string;
}

const { kicker, title, description } = Astro.props;
---

<header class="page-hero" data-enter>
  <p class="section-kicker">{kicker}</p>
  <h1>{title}</h1>
  {description && <p>{description}</p>}
  <slot />
</header>

<style>
  .page-hero {
    max-width: 54rem;
    padding-block: clamp(5rem, 10vw, 9rem) clamp(3rem, 7vw, 6rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 680;
    letter-spacing: -0.068em;
    line-height: 0.96;
  }

  p:not(.section-kicker) {
    max-width: 43rem;
    margin: 1.5rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  @media (max-width: 40rem) {
    h1 {
      overflow-wrap: anywhere;
    }
  }
</style>
