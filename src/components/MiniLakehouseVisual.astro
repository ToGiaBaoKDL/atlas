---
import VisualHeader from "./VisualHeader.astro";

interface Props {
  thumbnail?: boolean;
}

const { thumbnail = false } = Astro.props;

const stages = [
  { number: "01", label: "Define", title: "Data contracts", detail: "Schemas and ownership" },
  { number: "02", label: "Land", title: "Ingest safely", detail: "Idempotent publication" },
  { number: "03", label: "Refine", title: "Transform", detail: "Curated domain data" },
  { number: "04", label: "Verify", title: "Quality gates", detail: "Tests before release" },
  { number: "05", label: "Deliver", title: "Serve", detail: "Analytics and apps" },
];
---

<figure class:list={["lakehouse-visual", { "visual-thumbnail": thumbnail }]}>
  <VisualHeader
    eyebrow="Delivery workflow"
    title="Contract to trusted data product"
    status="Deployed"
  />

  <ol class="workflow-track" aria-label="Mini Lakehouse delivery workflow">
    {
      stages.map((stage, index) => (
        <li>
          <span class="workflow-number">{stage.number}</span>
          <small>{stage.label}</small>
          <strong>{stage.title}</strong>
          <p>{stage.detail}</p>
          {index < stages.length - 1 && (
            <span class="workflow-connector" aria-hidden="true">
              <i />
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <div class="workflow-operations">
    <span>OPERATIONS</span>
    <div>
      <span>Orchestration</span>
      <span>Observability</span>
      <span>Immutable releases</span>
    </div>
  </div>
</figure>

<style>
  .lakehouse-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 80% 15%, rgba(82, 105, 217, 0.17), transparent 32%),
      var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto;
    padding: clamp(1rem, 3vw, 1.6rem);
    color: var(--visual-text);
  }

  .workflow-track {
    --stage-gap: clamp(0.95rem, 1.8vw, 1.4rem);

    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--stage-gap);
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.3rem) 0;
    list-style: none;
  }

  .workflow-track li {
    position: relative;
    min-width: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-panel) 94%, transparent);
    padding: clamp(0.7rem, 1.5vw, 1rem);
  }

  .workflow-connector {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: calc(100% - 1px);
    width: calc(var(--stage-gap) + 2px);
    height: 1rem;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .workflow-connector::before {
    position: absolute;
    top: calc(50% - 1px);
    right: 0.15rem;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--visual-accent-strong), var(--visual-accent));
    content: "";
  }

  .workflow-connector::after {
    position: absolute;
    top: 50%;
    right: 0.08rem;
    width: 0.38rem;
    height: 0.38rem;
    transform: translateY(-50%) rotate(45deg);
    border-top: 2px solid var(--visual-accent);
    border-right: 2px solid var(--visual-accent);
    content: "";
  }

  .workflow-connector i {
    --visual-flow-distance: 0.55rem;

    position: absolute;
    z-index: 1;
    top: calc(50% - 0.14rem);
    left: 20%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--visual-accent);
    box-shadow: 0 0 0 0.18rem var(--visual-accent-glow);
  }

  .workflow-number {
    display: block;
    margin-bottom: 1.8rem;
    color: var(--visual-accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .workflow-track small,
  .workflow-operations > span {
    display: block;
    color: var(--visual-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 640;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .workflow-track strong {
    display: block;
    margin-top: 0.3rem;
    color: var(--visual-text);
    font-size: clamp(0.72rem, 1.3vw, 0.88rem);
    font-weight: 580;
  }

  .workflow-track p {
    margin: 0.35rem 0 0;
    color: var(--visual-soft);
    font-size: clamp(0.58rem, 1.1vw, 0.7rem);
    line-height: 1.4;
  }

  .workflow-operations {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--visual-border);
    padding-top: 1rem;
  }

  .workflow-operations > div {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .workflow-operations > div span {
    border: 1px solid var(--visual-border);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--visual-soft);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-reveal].is-revealed) .workflow-connector i {
      animation: visual-flow-inline var(--motion-flow) linear infinite;
      will-change: transform, opacity;
    }

    :global([data-reveal].is-revealed) li:nth-child(2) .workflow-connector i {
      animation-delay: var(--motion-flow-quarter);
    }

    :global([data-reveal].is-revealed) li:nth-child(3) .workflow-connector i {
      animation-delay: var(--motion-flow-half);
    }

    :global([data-reveal].is-revealed) li:nth-child(4) .workflow-connector i {
      animation-delay: calc(var(--motion-flow-half) + var(--motion-flow-quarter));
    }
  }

  @media (max-width: 40rem) {
    .lakehouse-visual:not(.visual-thumbnail) .workflow-track {
      --stage-gap: 0.85rem;

      grid-template-columns: 1fr;
      gap: var(--stage-gap);
      padding-block: 1.25rem;
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-track li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.1rem 0.65rem;
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-connector {
      top: calc(100% - 1px);
      left: 50%;
      width: 1rem;
      height: calc(var(--stage-gap) + 2px);
      transform: translateX(-50%);
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-connector::before {
      top: 0;
      right: auto;
      bottom: 0.15rem;
      left: calc(50% - 1px);
      width: 2px;
      height: auto;
      background: linear-gradient(var(--visual-accent-strong), var(--visual-accent));
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-connector::after {
      top: auto;
      right: auto;
      bottom: 0.08rem;
      left: 50%;
      transform: translateX(-50%) rotate(45deg);
      border-top: 0;
      border-right: 2px solid var(--visual-accent);
      border-bottom: 2px solid var(--visual-accent);
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-connector i {
      --visual-flow-distance: 0.45rem;

      top: 20%;
      left: calc(50% - 0.14rem);
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-number {
      grid-row: 1 / 4;
      margin: 0;
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-track small,
    .lakehouse-visual:not(.visual-thumbnail) .workflow-track strong,
    .lakehouse-visual:not(.visual-thumbnail) .workflow-track p {
      grid-column: 2;
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-operations {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .lakehouse-visual:not(.visual-thumbnail) .workflow-operations > div {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }

  @media (max-width: 40rem) and (prefers-reduced-motion: no-preference) {
    :global([data-reveal].is-revealed)
      .lakehouse-visual:not(.visual-thumbnail)
      .workflow-connector
      i {
      animation-name: visual-flow-block;
    }
  }
</style>
