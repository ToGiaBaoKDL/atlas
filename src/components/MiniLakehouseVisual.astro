---
import FlowArrow from "./FlowArrow.astro";
import VisualHeader from "./VisualHeader.astro";

const foundation = [
  { label: "OCI runtime", value: "Airflow · PostgreSQL" },
  { label: "Private edge", value: "Cloudflare Tunnel · Tailscale" },
  { label: "AWS resources", value: "IAM · Network · S3 · EMR" },
];

const dataStages = [
  { label: "Sources", title: "Batch inputs", detail: "GitHub · arXiv" },
  { label: "Compute", title: "Spark ingest", detail: "EMR Serverless" },
  { label: "01 · S3 / Iceberg", title: "Landing", detail: "Replayable windows" },
  { label: "02 · S3 / Iceberg", title: "Curated", detail: "Canonical entities" },
  { label: "03 · S3 / Iceberg", title: "Analytics", detail: "dbt-owned marts" },
];
---

<figure class="lakehouse-map">
  <VisualHeader
    eyebrow="Hybrid platform map"
    title="Provisioned foundation, explicit data layers"
    status="Deployed"
  />

  <div class="system-map" aria-label="Mini Lakehouse deployment and data architecture">
    <section class="foundation">
      <div class="layer-label">
        <span>Terraform</span>
        <small>provisions infrastructure</small>
      </div>
      <ul>
        {
          foundation.map((item) => (
            <li>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="execution-boundary">
      <div class="boundary-label">
        <span>Airflow orchestration</span>
        <small>submit · observe · retry</small>
      </div>

      <div class="data-pipeline">
        {
          dataStages.map((stage, index) => (
            <>
              <article class:list={["data-stage", { product: index >= 2 }]}>
                <span>{stage.label}</span>
                <strong>{stage.title}</strong>
                <small>{stage.detail}</small>
              </article>
              {index < dataStages.length - 1 && <FlowArrow />}
            </>
          ))
        }
      </div>

      <div class="serving-lane">
        <div class="lane-label">
          <span>Independent serving</span>
          <small>outside the data-layer sequence</small>
        </div>
        <article>
          <span>Document workload</span>
          <strong>Remote OCR service</strong>
          <small>provider-neutral · resumable</small>
        </article>
        <article>
          <span>Read-only access</span>
          <strong>Athena + Inspector</strong>
          <small>analytics · document review</small>
        </article>
      </div>
    </section>
  </div>
</figure>

<style>
  .lakehouse-map {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: var(--visual-canvas-ratio, auto);
    min-width: 0;
    grid-template-rows: auto minmax(0, 1fr);
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 80% 8%, rgba(163, 230, 53, 0.11), transparent 30%), var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto;
    padding: clamp(0.7rem, 1.2vw, 0.9rem);
    color: var(--visual-text);
  }

  .system-map {
    display: grid;
    min-height: 0;
    gap: 0.55rem;
    align-content: center;
    padding-top: clamp(0.55rem, 1.1vw, 0.7rem);
  }

  section,
  article {
    min-width: 0;
  }

  .foundation {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.56fr) minmax(0, 2.44fr);
    gap: 0.55rem;
    align-items: stretch;
    border-block: 1px solid var(--visual-border-soft);
    padding-block: 0.38rem;
  }

  .layer-label,
  .boundary-label,
  .lane-label {
    display: grid;
    align-content: center;
  }

  .layer-label {
    border-left: 2px solid var(--visual-accent-strong);
    padding-inline: 0.55rem;
  }

  .foundation ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foundation li {
    display: grid;
    align-content: center;
    border-left: 1px solid var(--visual-border-soft);
    padding: 0.22rem 0.48rem;
  }

  .layer-label span,
  .layer-label small,
  .boundary-label span,
  .boundary-label small,
  .foundation li span,
  .data-stage span,
  .data-stage small,
  .lane-label span,
  .lane-label small,
  .serving-lane article span,
  .serving-lane article small {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .layer-label span,
  .boundary-label span {
    color: var(--visual-accent);
  }

  .layer-label small,
  .boundary-label small,
  .foundation li span,
  .data-stage span,
  .data-stage small,
  .lane-label small,
  .serving-lane article span,
  .serving-lane article small {
    color: var(--visual-muted);
  }

  .foundation li strong {
    margin-top: 0.16rem;
    color: var(--visual-soft);
    font-size: clamp(0.5rem, 0.9vw, 0.61rem);
    font-weight: 560;
    line-height: 1.25;
  }

  .execution-boundary {
    position: relative;
    border: 1px dashed color-mix(in srgb, var(--visual-accent) 56%, var(--visual-border));
    border-radius: 0.42rem;
    padding: 1.35rem 0.55rem 0.1rem;
  }

  .boundary-label {
    position: absolute;
    top: -0.47rem;
    left: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--visual-bg);
    padding-inline: 0.32rem;
  }

  .data-pipeline {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) 0.24fr minmax(0, 1fr) 0.24fr minmax(0, 1fr) 0.24fr minmax(0, 1fr)
      0.24fr minmax(0, 1fr);
    gap: 0.2rem;
    align-items: center;
  }

  .data-stage {
    display: grid;
    min-height: 4.05rem;
    align-content: center;
    border: 1px solid var(--visual-border-soft);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--visual-panel) 96%, transparent);
    padding: 0.42rem 0.48rem;
  }

  .data-stage.product {
    border-color: color-mix(in srgb, var(--visual-accent) 24%, var(--visual-border));
  }

  .data-stage.product > span {
    color: var(--visual-accent);
  }

  .data-stage strong,
  .serving-lane article strong {
    margin-block: 0.18rem;
    color: var(--visual-text);
    font-size: clamp(0.56rem, 1vw, 0.68rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .serving-lane {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.62fr) repeat(2, minmax(0, 1fr));
    gap: 0.42rem;
    margin-top: 0.48rem;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.48rem;
  }

  .lane-label {
    padding-inline: 0.45rem;
  }

  .lane-label span {
    color: var(--visual-soft);
  }

  .serving-lane article {
    display: grid;
    align-content: center;
    border: 1px solid var(--visual-border-soft);
    border-radius: 0.35rem;
    background: var(--visual-panel-soft);
    padding: 0.32rem 0.48rem;
  }
</style>
