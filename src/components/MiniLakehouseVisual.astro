---
import VisualHeader from "./VisualHeader.astro";

const sources = ["GitHub Archive", "arXiv metadata", "Documents"];
const dataProducts = ["Landing", "Curated", "Analytics"];
---

<figure class="lakehouse-map">
  <VisualHeader
    eyebrow="Hybrid platform map"
    title="Private control plane, managed data plane"
    status="Deployed"
  />

  <div class="architecture" aria-label="Mini Lakehouse system boundaries">
    <svg class="routes" viewBox="0 0 1000 330" preserveAspectRatio="none" aria-hidden="true">
      <path class="route route-input" d="M150 165 C220 165 218 165 285 165"></path>
      <path class="route route-control" d="M785 95 C690 95 720 135 620 135"></path>
      <path class="route route-control" d="M785 235 C690 235 715 196 620 196"></path>
      <path class="route route-data" d="M395 165 H510 H625"></path>
      <circle cx="285" cy="165" r="4"></circle>
      <circle cx="510" cy="165" r="4"></circle>
      <circle cx="625" cy="165" r="4"></circle>
    </svg>

    <section class="source-zone">
      <span class="zone-label">Bounded sources</span>
      <ul>
        {sources.map((source) => <li>{source}</li>)}
      </ul>
    </section>

    <section class="data-zone">
      <div class="zone-heading">
        <span class="zone-label">AWS data plane</span>
        <small>Ephemeral compute</small>
      </div>
      <div class="compute-node">
        <span>EXECUTE</span>
        <strong>EMR Serverless</strong>
        <small>Spark producers</small>
      </div>
      <ol class="product-line">
        {
          dataProducts.map((product, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{product}</strong>
              <small>{index === 0 ? "Replayable" : index === 1 ? "Iceberg" : "Domain-owned"}</small>
            </li>
          ))
        }
      </ol>
      <div class="serve-node"><span>QUERY</span><strong>Athena + dbt</strong></div>
    </section>

    <div class="service-column">
      <section class="private-zone">
        <div class="zone-heading">
          <span class="zone-label">Private services</span>
          <small>OCI / ARM</small>
        </div>
        <strong>Airflow coordinates</strong>
        <p>PostgreSQL · Inspector</p>
        <span class="access-note">Tailscale + Cloudflare Access</span>
      </section>
      <section class="worker-zone">
        <span class="zone-label">Remote document compute</span>
        <strong>Provider-neutral OCR</strong>
        <small>Pinned worker · resumable run</small>
      </section>
    </div>
  </div>

  <footer>
    <span><i class="control"></i>Control</span>
    <span><i class="data"></i>Data</span>
    <strong>No public ingress · short-lived identity · independent releases</strong>
  </footer>
</figure>

<style>
  .lakehouse-map {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.59;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 76% 14%, rgba(163, 230, 53, 0.1), transparent 31%),
      radial-gradient(circle at 12% 82%, rgba(111, 131, 238, 0.16), transparent 28%),
      var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto,
      auto;
    padding: clamp(1rem, 2.7vw, 1.55rem);
    color: var(--visual-text);
  }

  .architecture {
    position: relative;
    display: grid;
    height: calc(100% - 6rem);
    grid-template-columns: 0.64fr 1.65fr 0.82fr;
    gap: clamp(0.75rem, 1.8vw, 1.2rem);
    align-items: stretch;
    padding-block: clamp(1rem, 2vw, 1.35rem);
  }

  .routes {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .route {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .route-input,
  .route-data {
    stroke: var(--visual-accent-strong);
  }

  .route-control {
    stroke: var(--visual-success);
    stroke-dasharray: 4 5;
  }

  .routes circle {
    fill: var(--visual-accent);
    filter: drop-shadow(0 0 5px var(--visual-accent));
  }

  section,
  .service-column {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  section {
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-panel) 94%, transparent);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
    padding: clamp(0.65rem, 1.4vw, 0.9rem);
  }

  .zone-label,
  .zone-heading small,
  .compute-node span,
  .compute-node small,
  .product-line span,
  .product-line small,
  .serve-node span,
  .access-note,
  .worker-zone small,
  footer {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .zone-label {
    color: var(--visual-muted);
  }

  .zone-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-bottom: 1px solid var(--visual-border-soft);
    padding-bottom: 0.55rem;
  }

  .zone-heading small {
    color: var(--visual-code);
  }

  .source-zone {
    display: grid;
    align-content: center;
  }

  .source-zone ul {
    display: grid;
    gap: 0.42rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-zone li {
    border-left: 2px solid var(--visual-accent-strong);
    background: rgba(255, 255, 255, 0.025);
    padding: 0.42rem 0.5rem;
    color: var(--visual-soft);
    font-size: clamp(0.56rem, 1vw, 0.67rem);
  }

  .data-zone {
    display: grid;
    grid-template-columns: 0.75fr 1.7fr;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.62rem;
  }

  .data-zone .zone-heading,
  .serve-node {
    grid-column: 1 / -1;
  }

  .compute-node {
    display: grid;
    align-content: center;
    border: 1px solid var(--visual-border-soft);
    border-radius: 0.35rem;
    background: rgba(111, 131, 238, 0.07);
    padding: 0.55rem;
  }

  .compute-node span,
  .compute-node small,
  .product-line span,
  .product-line small,
  .serve-node span {
    color: var(--visual-muted);
  }

  .compute-node strong,
  .product-line strong,
  .serve-node strong {
    color: var(--visual-text);
    font-size: clamp(0.58rem, 1.15vw, 0.74rem);
    font-weight: 590;
  }

  .compute-node strong {
    margin-block: 0.25rem;
  }

  .product-line {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.38rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-line li {
    display: grid;
    align-content: center;
    border: 1px solid var(--visual-border-soft);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.018);
    padding: 0.48rem;
  }

  .product-line strong {
    margin-block: 0.2rem;
  }

  .serve-node {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.52rem;
  }

  .service-column {
    display: grid;
    grid-template-rows: 1.25fr 0.75fr;
    gap: 0.65rem;
  }

  .private-zone,
  .worker-zone {
    display: grid;
    align-content: center;
  }

  .private-zone .zone-heading {
    margin-bottom: 0.7rem;
  }

  .private-zone > strong,
  .worker-zone strong {
    color: var(--visual-text);
    font-size: clamp(0.62rem, 1.15vw, 0.78rem);
    font-weight: 590;
  }

  .private-zone p {
    margin: 0.3rem 0 0.65rem;
    color: var(--visual-soft);
    font-size: clamp(0.54rem, 1vw, 0.65rem);
  }

  .access-note {
    color: var(--visual-code);
  }

  .worker-zone {
    gap: 0.25rem;
  }

  .worker-zone small {
    color: var(--visual-soft);
  }

  footer {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.75rem;
    color: var(--visual-muted);
  }

  footer span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  footer i {
    width: 0.75rem;
    height: 2px;
  }

  footer i.control {
    background: var(--visual-success);
  }

  footer i.data {
    background: var(--visual-accent);
  }

  footer strong {
    margin-left: auto;
    color: var(--visual-soft);
    font-weight: 560;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-reveal].is-revealed) .route-data,
    :global([data-reveal].is-revealed) .route-input {
      animation: route-dash 1.5s linear infinite;
      stroke-dasharray: 5 7;
    }

    @keyframes route-dash {
      to {
        stroke-dashoffset: -24;
      }
    }
  }
</style>
