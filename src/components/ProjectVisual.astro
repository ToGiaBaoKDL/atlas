---
import VisualFrame from "./VisualFrame.astro";
import { getProjectVisual } from "./projectVisuals";

interface Props {
  projectId: string;
  contained?: boolean;
  thumbnail?: boolean;
}

const { projectId, contained = false, thumbnail = false } = Astro.props;
const visual = getProjectVisual(projectId);
const Visual = visual?.component;
---

{
  Visual &&
    (contained ? (
      <section class="container" aria-label={visual.label} data-reveal>
        <Visual />
      </section>
    ) : thumbnail ? (
      <VisualFrame mobileShape={visual.mobileShape}>
        <Visual thumbnail />
      </VisualFrame>
    ) : (
      <Visual />
    ))
}
