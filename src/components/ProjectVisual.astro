---
import VisualFrame from "./VisualFrame.astro";
import { getProjectVisual } from "./projectVisuals";

interface Props {
  projectId: string;
  presentation: "case-study" | "thumbnail";
}

const { projectId, presentation } = Astro.props;
const visual = getProjectVisual(projectId);
const Visual = visual.component;
---

{
  presentation === "case-study" ? (
    <section class="project-cover-visual container" aria-label={visual.label} data-reveal>
      <VisualFrame aspect="landscape" presentation="detail">
        <Visual />
      </VisualFrame>
    </section>
  ) : (
    <VisualFrame aspect="landscape" presentation="thumbnail">
      <Visual />
    </VisualFrame>
  )
}
