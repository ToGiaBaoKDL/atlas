---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  collection: "writing" | "notes";
}

const { collection } = Astro.props;
const copy = {
  writing: {
    kicker: "Long-form",
    title: "Writing",
    description: "Technical essays built around one clear engineering argument.",
    empty: "The first essay is being prepared.",
    detail:
      "It examines why an Iceberg catalog control plane—not Terraform—should own table definitions and evolution.",
  },
  notes: {
    kicker: "Public notebook",
    title: "Notes",
    description: "Concise, evolving notes from systems I build and operate.",
    empty: "The first set of engineering notes is being edited.",
    detail:
      "Topics include Iceberg ownership, idempotent publication, immutable releases, OIDC and typed AI workflows.",
  },
}[collection];
---

<BaseLayout title={copy.title} description={copy.description} section={collection} noindex>
  <div class="container">
    <header class="page-hero">
      <p class="section-kicker">{copy.kicker}</p>
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
    </header>
    <section class="empty-state">
      <div>
        <h2>{copy.empty}</h2>
        <p>{copy.detail}</p>
      </div>
    </section>
  </div>
  <div class="section"></div>
</BaseLayout>
