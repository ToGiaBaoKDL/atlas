---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";

interface Props {
  collection: "writing" | "notes";
}

const { collection } = Astro.props;
const copy = {
  writing: {
    kicker: "Long-form",
    title: "Writing",
    description: "Technical essays built around one clear engineering argument.",
    status: "Publishing soon",
    empty: "The first essay is being prepared.",
    detail:
      "It examines why an Iceberg catalog control plane—not Terraform—should own table definitions and evolution.",
  },
  notes: {
    kicker: "Public notebook",
    title: "Notes",
    description: "Concise, evolving notes from systems I build and operate.",
    status: "Publishing soon",
    empty: "The first set of engineering notes is being edited.",
    detail:
      "Topics include Iceberg ownership, idempotent publication, immutable releases, OIDC and typed AI workflows.",
  },
}[collection];
---

<BaseLayout title={copy.title} description={copy.description} section={collection} noindex>
  <div class="container">
    <PageHero kicker={copy.kicker} title={copy.title} description={copy.description} />
    <section class="empty-state">
      <p class="empty-state-status">{copy.status}</p>
      <div class="empty-state-copy">
        <h2>{copy.empty}</h2>
        <p>{copy.detail}</p>
        <div class="empty-state-actions">
          <a class="button" href="/work/">Explore selected work</a>
          <a class="text-link" href="/about/">About me →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .empty-state {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border-block: 1px solid var(--border);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .empty-state-status {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .empty-state-copy {
    max-width: 34rem;
  }

  .empty-state h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .empty-state-copy > p {
    color: var(--text-soft);
  }

  .empty-state-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 40rem) {
    .empty-state {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .empty-state-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
