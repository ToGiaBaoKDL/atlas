---
import VisualHeader from "./VisualHeader.astro";
---

<figure class="signature-figure">
  <div
    class="platform-visual"
    role="img"
    aria-label="A modern data platform connecting source systems to a governed data foundation and trusted data experiences"
  >
    <VisualHeader eyebrow="Reference architecture" title="Modern data platform" status="Healthy" />

    <div class="platform-map">
      <section class="platform-sources">
        <span class="platform-label">Sources</span>
        <div class="source-stack">
          <span>Applications</span>
          <span>Events</span>
          <span>Files & APIs</span>
        </div>
      </section>

      <span class="platform-connector" aria-hidden="true"><i></i></span>

      <section class="platform-foundation">
        <span class="platform-label">Unified data foundation</span>
        <strong>Lakehouse</strong>
        <div class="foundation-layers">
          <span>Raw</span>
          <span>Curated</span>
          <span>Semantic</span>
        </div>
      </section>

      <span class="platform-connector" aria-hidden="true"><i></i></span>

      <section class="platform-experiences">
        <span class="platform-label">Experiences</span>
        <div class="experience-stack">
          <span>Analytics</span>
          <span>Data products</span>
          <span>AI systems</span>
        </div>
      </section>
    </div>

    <div class="control-plane">
      <span class="platform-label">Control plane</span>
      <div>
        <span>Orchestrate</span>
        <span>Govern</span>
        <span>Observe</span>
        <span>Secure</span>
      </div>
    </div>
  </div>
  <figcaption class="signature-caption">
    One governed foundation, many ways to create value from data.
  </figcaption>
</figure>

<style>
  .signature-figure {
    min-width: 0;
    margin: 0;
  }

  .platform-visual {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--visual-border-soft);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px), var(--visual-bg);
    background-size: 1.4rem 1.4rem;
    box-shadow: 0 1.5rem 4rem rgba(16, 21, 16, 0.18);
    color: var(--visual-text-strong);
    padding: clamp(1rem, 2.5vw, 1.45rem);
  }

  .platform-visual::before {
    position: absolute;
    top: -7rem;
    right: -6rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: rgba(76, 105, 231, 0.2);
    content: "";
    filter: blur(5rem);
  }

  .platform-label {
    color: var(--visual-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 640;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .platform-map {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.75fr) 1.5rem minmax(10rem, 1.45fr) 1.5rem minmax(
        6.5rem,
        0.9fr
      );
    gap: 0.6rem;
    align-items: center;
    padding-block: clamp(1.4rem, 4vw, 2.2rem);
  }

  .platform-sources,
  .platform-experiences,
  .platform-foundation {
    min-width: 0;
  }

  .source-stack,
  .experience-stack {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.65rem;
  }

  .source-stack span,
  .experience-stack span {
    border: 1px solid var(--visual-border);
    border-radius: 0.4rem;
    background: var(--visual-panel);
    padding: 0.58rem 0.65rem;
    color: var(--visual-text);
    font-size: 0.66rem;
    line-height: 1.2;
  }

  .platform-foundation {
    border: 1px solid var(--visual-accent-strong);
    border-radius: 0.65rem;
    background: linear-gradient(145deg, rgba(66, 91, 205, 0.24), rgba(23, 29, 23, 0.94));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.05);
    padding: 1rem;
  }

  .platform-foundation > strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--visual-text-strong);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 620;
    letter-spacing: -0.035em;
  }

  .foundation-layers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.35rem;
  }

  .foundation-layers span {
    padding: 0.45rem 0.25rem;
    color: var(--visual-accent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-align: center;
  }

  .foundation-layers span:not(:last-child) {
    border-right: 1px solid rgba(255, 255, 255, 0.11);
  }

  .platform-connector {
    position: relative;
    display: block;
    height: 1px;
    background: var(--visual-accent-strong);
  }

  .platform-connector::after {
    position: absolute;
    top: 50%;
    right: -1px;
    width: 0.35rem;
    height: 0.35rem;
    transform: translateY(-50%) rotate(45deg);
    border-top: 1px solid var(--visual-accent);
    border-right: 1px solid var(--visual-accent);
    content: "";
  }

  .platform-connector i {
    --visual-flow-distance: 0.75rem;

    position: absolute;
    top: -2px;
    left: 15%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--visual-accent);
  }

  .control-plane {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--visual-border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--visual-panel) 85%, transparent);
    padding: 0.75rem;
  }

  .control-plane > div {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    border-left: 1px solid var(--visual-border);
  }

  .control-plane > div span {
    padding-inline: 0.5rem;
    color: var(--visual-soft);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    text-align: center;
  }

  .control-plane > div span:not(:last-child) {
    border-right: 1px solid var(--visual-border);
  }

  .signature-caption {
    margin-top: 0.8rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-enter]) .platform-connector i {
      animation: visual-flow-inline 2.6s var(--ease-out) 450ms 2;
    }
  }

  @media (max-width: 56rem) {
    .signature-figure {
      max-width: 42rem;
    }
  }

  @media (max-width: 40rem) {
    .platform-map {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding-block: 1.25rem;
    }

    .source-stack,
    .experience-stack {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .source-stack span,
    .experience-stack span {
      padding-inline: 0.4rem;
      text-align: center;
    }

    .platform-connector {
      width: 1px;
      height: 1.2rem;
      margin-inline: auto;
    }

    .platform-connector::after {
      top: auto;
      right: 50%;
      bottom: -1px;
      transform: translateX(50%) rotate(135deg);
    }

    .platform-connector i {
      --visual-flow-distance: 0.55rem;

      top: 15%;
      left: -2px;
    }

    .control-plane {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .control-plane > div {
      border-top: 1px solid var(--visual-border);
      border-left: 0;
      padding-top: 0.6rem;
    }
  }

  @media (max-width: 40rem) and (prefers-reduced-motion: no-preference) {
    :global([data-enter]) .platform-connector i {
      animation-name: visual-flow-block;
    }
  }
</style>
