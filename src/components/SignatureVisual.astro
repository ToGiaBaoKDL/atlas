---
import FlowArrow from "./FlowArrow.astro";
import VisualHeader from "./VisualHeader.astro";

const products = ["Landing", "Curated", "Analytics"];
const capabilities = ["Orchestrate", "Test", "Catalog", "Observe", "Secure"];
---

<figure class="signature-figure">
  <div
    class="platform-visual"
    role="img"
    aria-label="A data platform that turns bounded sources into owned lakehouse products and trusted serving interfaces"
  >
    <VisualHeader
      eyebrow="Platform blueprint"
      title="A data product path with explicit ownership"
      status="Reliable by design"
    />

    <div class="platform-boundary">
      <div class="boundary-label">
        <span>Data plane</span>
        <small>contracts at every boundary</small>
      </div>

      <div class="platform-map">
        <section class="edge-node">
          <span>Sources</span>
          <strong>Bounded inputs</strong>
          <small>batch · events · APIs</small>
        </section>

        <FlowArrow particle />

        <section class="compute-node">
          <span>Execution</span>
          <strong>Ingest + transform</strong>
          <small>replaceable compute</small>
        </section>

        <FlowArrow particle delayed />

        <section class="product-node">
          <span>Owned data products</span>
          <ol>
            {
              products.map((product, index) => (
                <li>
                  <small>0{index + 1}</small>
                  {product}
                </li>
              ))
            }
          </ol>
        </section>

        <FlowArrow particle />

        <section class="edge-node">
          <span>Serving</span>
          <strong>Trusted interfaces</strong>
          <small>BI · APIs · AI/ML</small>
        </section>
      </div>

      <div class="platform-capabilities">
        <span>Platform plane</span>
        <ul>
          {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <figcaption>
    Compute can change; contracts and owned data products keep the system stable.
  </figcaption>
</figure>

<style>
  .signature-figure {
    min-width: 0;
    margin: 0;
  }

  .platform-visual {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--visual-border-soft);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      radial-gradient(circle at 82% 9%, rgba(163, 230, 53, 0.1), transparent 31%), var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto;
    box-shadow: 0 1.5rem 4rem rgba(16, 21, 16, 0.18);
    color: var(--visual-text-strong);
    padding: clamp(0.85rem, 2vw, 1.15rem);
  }

  .platform-boundary {
    position: relative;
    margin-top: clamp(0.8rem, 2vw, 1.1rem);
    border: 1px dashed color-mix(in srgb, var(--visual-accent) 52%, var(--visual-border));
    border-radius: 0.5rem;
    padding: 1.25rem 0.55rem 0.55rem;
  }

  .boundary-label {
    position: absolute;
    top: -0.48rem;
    left: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--visual-bg);
    padding-inline: 0.32rem;
  }

  .boundary-label span,
  .boundary-label small,
  section > span,
  section > small,
  .product-node li small,
  .platform-capabilities > span,
  .platform-capabilities li {
    font-family: var(--font-mono);
    font-size: 0.49rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .boundary-label span {
    color: var(--visual-accent);
  }

  .boundary-label small,
  section > span,
  section > small,
  .product-node li small,
  .platform-capabilities > span {
    color: var(--visual-muted);
  }

  .platform-map {
    display: grid;
    grid-template-columns:
      minmax(0, 0.82fr) minmax(1.1rem, 0.2fr) minmax(0, 0.95fr) minmax(1.1rem, 0.2fr)
      minmax(0, 1.55fr) minmax(1.1rem, 0.2fr) minmax(0, 0.82fr);
    gap: 0.2rem;
    align-items: stretch;
  }

  section {
    display: grid;
    min-width: 0;
    min-height: 5.6rem;
    align-content: center;
    border: 1px solid var(--visual-border-soft);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--visual-panel) 95%, transparent);
    padding: 0.5rem;
  }

  section strong {
    margin-block: 0.25rem;
    color: var(--visual-text);
    font-size: clamp(0.58rem, 1.25vw, 0.73rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .product-node {
    border-color: color-mix(in srgb, var(--visual-accent) 38%, var(--visual-border));
    background: color-mix(in srgb, var(--visual-accent) 4%, var(--visual-panel));
  }

  .product-node > span,
  .product-node li small {
    color: var(--visual-soft);
  }

  .product-node ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-node li {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
    border-left: 1px solid var(--visual-border);
    padding-left: 0.35rem;
    color: var(--visual-soft);
    font-size: clamp(0.5rem, 1vw, 0.62rem);
  }

  .platform-capabilities {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    margin-top: 0.5rem;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.5rem;
  }

  .platform-capabilities ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platform-capabilities li {
    border-left: 1px solid var(--visual-border);
    color: var(--visual-soft);
    text-align: center;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  @media (max-width: 40rem) {
    figcaption {
      color: var(--visual-soft);
    }
  }
</style>
