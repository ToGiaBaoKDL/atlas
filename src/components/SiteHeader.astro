---
import { site, ui } from "../data/site";

interface Props {
  section?: "work" | "writing" | "notes" | "about";
}

const { section } = Astro.props;
const navItems = [
  { key: "work", href: "/work/", label: ui.nav.work },
  { key: "writing", href: "/writing/", label: ui.nav.writing },
  { key: "notes", href: "/notes/", label: ui.nav.notes },
  { key: "about", href: "/about/", label: ui.nav.about },
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — Home`}>{site.name}</a>

    <div class="desktop-controls">
      <nav class="desktop-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        class="icon-button"
        type="button"
        data-theme-toggle
        aria-label={ui.themeToggle}
        aria-pressed="false"
      >
        <svg
          class="theme-icon-sun"
          aria-hidden="true"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="3.5"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
          ></path>
        </svg>
        <svg
          class="theme-icon-moon"
          aria-hidden="true"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M20.5 15.4A8.6 8.6 0 0 1 8.6 3.5 8.7 8.7 0 1 0 20.5 15.4Z"></path>
        </svg>
      </button>
    </div>

    <div class="mobile-controls">
      <button
        class="menu-button"
        type="button"
        data-menu-open
        aria-label={ui.menuOpen}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          aria-hidden="true"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label={ui.navigationLabel}>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <span class="wordmark">{site.name}</span>
        <button class="icon-button" type="button" data-menu-close aria-label={ui.menuClose}>
          <svg
            aria-hidden="true"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <nav class="mobile-menu-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-menu-utilities">
        <span>Appearance</span>
        <button
          class="icon-button"
          type="button"
          data-theme-toggle
          aria-label={ui.themeToggle}
          aria-pressed="false"
        >
          <svg
            class="theme-icon-sun"
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="3.5"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
            ></path>
          </svg>
          <svg
            class="theme-icon-moon"
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M20.5 15.4A8.6 8.6 0 0 1 8.6 3.5 8.7 8.7 0 1 0 20.5 15.4Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = menu?.querySelector<HTMLButtonElement>("[data-menu-close]");

  openButton?.addEventListener("click", () => {
    menu?.showModal();
    openButton.setAttribute("aria-expanded", "true");
  });
  closeButton?.addEventListener("click", () => menu?.close());
  menu?.addEventListener("close", () => openButton?.setAttribute("aria-expanded", "false"));
  menu?.addEventListener("click", (event) => {
    if (event.target === menu) menu.close();
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));

  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const syncThemeControls = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    themeButtons.forEach((button) => button.setAttribute("aria-pressed", String(isDark)));
    document
      .querySelector("[data-theme-color]")
      ?.setAttribute("content", isDark ? "#111310" : "#f7f6f2");
  };

  syncThemeControls();

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      syncThemeControls();
      try {
        localStorage.setItem("theme", next);
      } catch {
        // The selected theme still applies when storage is unavailable.
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    height: var(--header-height);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    background: color-mix(in srgb, var(--bg) 91%, transparent);
    backdrop-filter: blur(1rem);
  }

  .header-inner,
  .desktop-controls,
  .desktop-nav,
  .mobile-controls,
  .mobile-menu-top,
  .mobile-menu-utilities {
    display: flex;
    align-items: center;
  }

  .header-inner {
    height: 100%;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    flex: 0 0 auto;
    font-weight: 720;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .desktop-controls {
    min-width: 0;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .desktop-nav {
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .desktop-nav a {
    position: relative;
    color: var(--text-soft);
    font-size: 0.91rem;
    font-weight: 540;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--text);
  }

  .desktop-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .icon-button,
  .menu-button {
    display: inline-grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
  }

  .icon-button:hover,
  .menu-button:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .theme-icon-moon,
  :global(:root[data-theme="dark"]) .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-moon {
    display: block;
  }

  .mobile-controls {
    display: none;
    gap: 0.45rem;
  }

  .mobile-menu {
    width: min(100%, 30rem);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    padding: 0;
  }

  .mobile-menu::backdrop {
    background: rgba(8, 10, 8, 0.54);
    backdrop-filter: blur(0.2rem);
  }

  .mobile-menu-inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: max(1rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(1.5rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
  }

  .mobile-menu-top,
  .mobile-menu-utilities {
    justify-content: space-between;
  }

  .mobile-menu-nav {
    display: grid;
    gap: 0.2rem;
    margin-block: 3rem auto;
  }

  .mobile-menu-nav a {
    border-bottom: 1px solid var(--border);
    padding-block: 1rem;
    font-size: clamp(1.5rem, 8vw, 2rem);
    font-weight: 610;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .mobile-menu-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .mobile-menu-utilities {
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  @media (max-width: 56rem) {
    .desktop-controls {
      display: none;
    }

    .mobile-controls {
      display: flex;
    }
  }
</style>
