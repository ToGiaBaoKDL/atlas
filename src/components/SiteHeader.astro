---
import { site, ui } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  section?: "projects" | "writing" | "about";
}

const { section } = Astro.props;
const navItems = [
  { key: "projects", href: "/projects/", label: ui.nav.projects },
  { key: "writing", href: "/writing/", label: ui.nav.writing },
  { key: "about", href: "/about/", label: ui.nav.about },
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — Home`}>{site.name}</a>

    <div class="desktop-controls">
      <nav class="desktop-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>

    <div class="mobile-controls">
      <button
        class="menu-button"
        type="button"
        data-menu-open
        aria-label={ui.menuOpen}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label={ui.navigationLabel}>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <span class="wordmark">{site.name}</span>
        <button class="icon-button" type="button" data-menu-close aria-label={ui.menuClose}>
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <nav class="mobile-menu-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-menu-utilities">
        <span>Appearance</span>
        <ThemeToggle />
      </div>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = menu?.querySelector<HTMLButtonElement>("[data-menu-close]");

  openButton?.addEventListener("click", () => {
    menu?.showModal();
    openButton.setAttribute("aria-expanded", "true");
  });
  closeButton?.addEventListener("click", () => menu?.close());
  menu?.addEventListener("close", () => openButton?.setAttribute("aria-expanded", "false"));
  menu?.addEventListener("click", (event) => {
    if (event.target === menu) menu.close();
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    height: var(--header-height);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    background: color-mix(in srgb, var(--bg) 91%, transparent);
    backdrop-filter: blur(1rem);
  }

  .header-inner,
  .desktop-controls,
  .desktop-nav,
  .mobile-controls,
  .mobile-menu-top,
  .mobile-menu-utilities {
    display: flex;
    align-items: center;
  }

  .header-inner {
    height: 100%;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    flex: 0 0 auto;
    font-weight: 720;
    letter-spacing: -0.04em;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .desktop-controls {
    min-width: 0;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .desktop-nav {
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .desktop-nav a {
    position: relative;
    color: var(--text-soft);
    font-size: 0.91rem;
    font-weight: 540;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--text);
  }

  .desktop-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .icon-button,
  .menu-button {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .icon-button:hover,
  .menu-button:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .mobile-controls {
    display: none;
    gap: 0.45rem;
  }

  .mobile-menu {
    width: min(100%, 30rem);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    padding: 0;
  }

  .mobile-menu::backdrop {
    background: rgba(8, 10, 8, 0.54);
    backdrop-filter: blur(0.2rem);
  }

  .mobile-menu-inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: max(1rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(1.5rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
  }

  .mobile-menu-top,
  .mobile-menu-utilities {
    justify-content: space-between;
  }

  .mobile-menu-nav {
    display: grid;
    gap: 0.1rem;
    margin-block: 2.5rem auto;
  }

  .mobile-menu-nav a {
    border-bottom: 1px solid var(--border);
    padding-block: 0.75rem;
    font-size: clamp(1.1rem, 5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .mobile-menu-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .mobile-menu-utilities {
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  @media (max-width: 56rem) {
    .desktop-controls {
      display: none;
    }

    .mobile-controls {
      display: flex;
    }
  }
</style>
