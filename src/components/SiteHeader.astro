---
import { site, ui } from "../data/site";

interface Props {
  section?: "work" | "writing" | "notes" | "about";
}

const { section } = Astro.props;
const navItems = [
  { key: "work", href: "/work/", label: ui.nav.work },
  { key: "writing", href: "/writing/", label: ui.nav.writing },
  { key: "notes", href: "/notes/", label: ui.nav.notes },
  { key: "about", href: "/about/", label: ui.nav.about },
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — Home`}>{site.name}</a>

    <div class="desktop-controls">
      <nav class="desktop-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <button class="icon-button" type="button" data-theme-toggle aria-label={ui.themeToggle}>
        <svg
          class="theme-icon-sun"
          aria-hidden="true"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="3.5"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
          ></path>
        </svg>
        <svg
          class="theme-icon-moon"
          aria-hidden="true"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M20.5 15.4A8.6 8.6 0 0 1 8.6 3.5 8.7 8.7 0 1 0 20.5 15.4Z"></path>
        </svg>
      </button>
    </div>

    <div class="mobile-controls">
      <button
        class="menu-button"
        type="button"
        data-menu-open
        aria-label={ui.menuOpen}
        aria-controls="mobile-menu"
      >
        <svg
          aria-hidden="true"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label={ui.navigationLabel}>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <span class="wordmark">{site.name}</span>
        <button class="icon-button" type="button" data-menu-close aria-label={ui.menuClose}>
          <svg
            aria-hidden="true"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <nav class="mobile-menu-nav" aria-label={ui.navigationLabel}>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={section === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-menu-utilities">
        <span>Appearance</span>
        <button class="icon-button" type="button" data-theme-toggle aria-label={ui.themeToggle}>
          <svg
            class="theme-icon-sun"
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="3.5"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
            ></path>
          </svg>
          <svg
            class="theme-icon-moon"
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M20.5 15.4A8.6 8.6 0 0 1 8.6 3.5 8.7 8.7 0 1 0 20.5 15.4Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = menu?.querySelector<HTMLButtonElement>("[data-menu-close]");

  openButton?.addEventListener("click", () => menu?.showModal());
  closeButton?.addEventListener("click", () => menu?.close());
  menu?.addEventListener("click", (event) => {
    if (event.target === menu) menu.close();
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
    });
  });
</script>
