---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { writingTopics } from "../data/topics";
import PageHero from "./PageHero.astro";
import WritingList from "./WritingList.astro";

const entries = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const activeTopics = writingTopics.filter(({ slug }) =>
  entries.some(({ data }) => data.topics.includes(slug)),
);

const copy = {
  kicker: "Essays · Notes · Research",
  title: "Writing",
  description: "Technical writing on ideas, patterns and problems worth examining carefully.",
  status: "Publishing soon",
  empty: "The first piece is being prepared.",
  detail:
    "Entries will range from focused essays to concise engineering notes, organized by technical topic.",
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  section="writing"
  noindex={entries.length === 0}
>
  <div class="container">
    <PageHero kicker={copy.kicker} title={copy.title} description={copy.description} />
    {
      entries.length > 0 ? (
        <section class="writing-collection" aria-label="Published writing" data-reveal>
          {activeTopics.length > 1 && (
            <nav class="topic-nav" aria-label="Browse by topic">
              <span>Browse by topic</span>
              <ul>
                {activeTopics.map((topic) => (
                  <li>
                    <a href={`/topics/${topic.slug}/`}>{topic.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <WritingList entries={entries} />
        </section>
      ) : (
        <section class="empty-state" data-reveal>
          <p class="empty-state-status">{copy.status}</p>
          <div class="empty-state-copy">
            <h2>{copy.empty}</h2>
            <p>{copy.detail}</p>
            <ul class="writing-topics" aria-label="Writing topics">
              {writingTopics.map((topic) => (
                <li>{topic.label}</li>
              ))}
            </ul>
            <div class="empty-state-actions">
              <a class="button" href="/projects/">
                Explore projects
              </a>
              <a class="text-link" href="/about/">
                About me →
              </a>
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .writing-collection {
    margin-bottom: clamp(5rem, 10vw, 9rem);
  }

  .topic-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .topic-nav > span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topic-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-nav a {
    display: block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .topic-nav a:hover,
  .topic-nav a:focus-visible {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .empty-state {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border-block: 1px solid var(--border);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .empty-state-status {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .empty-state-copy {
    max-width: 34rem;
  }

  .empty-state h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .empty-state-copy > p {
    color: var(--text-soft);
  }

  .writing-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .writing-topics li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .empty-state-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 40rem) {
    .topic-nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .topic-nav ul {
      justify-content: flex-start;
    }

    .empty-state {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .empty-state-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
