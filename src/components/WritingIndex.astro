---
import { getPublishedWriting, selectWritingSeries } from "../data/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { writingSeries } from "../data/series";
import { writingTopics } from "../data/topics";
import PageHero from "./PageHero.astro";
import WritingList from "./WritingList.astro";

const entries = await getPublishedWriting();
const activeTopics = writingTopics.filter(({ slug }) =>
  entries.some(({ data }) => data.topics.includes(slug)),
);
const seriesGroups = writingSeries
  .map((series) => selectWritingSeries(entries, series.id))
  .filter(({ entries }) => entries.length > 0);
const standaloneEntries = entries.filter(({ data }) => !data.series);

const copy = {
  kicker: "Essays · Notes · Research",
  title: "Writing",
  description: "Technical writing on ideas, patterns and problems worth examining carefully.",
};
---

<BaseLayout title={copy.title} description={copy.description} section="writing">
  <div class="container">
    <PageHero kicker={copy.kicker} title={copy.title} description={copy.description} />
    <section class="writing-collection" aria-label="Published writing" data-reveal>
      {
        activeTopics.length > 1 && (
          <nav class="topic-nav" aria-label="Browse by topic">
            <span>Browse by topic</span>
            <ul>
              {activeTopics.map((topic) => (
                <li>
                  <a href={`/topics/${topic.slug}/`}>{topic.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        seriesGroups.map(({ series, entries: seriesEntries, isComplete }) => {
          return (
            <section
              class="series-group"
              id={`series-${series.id}`}
              aria-labelledby={`series-title-${series.id}`}
            >
              <header class="series-header">
                <div>
                  <p class="section-kicker">
                    {isComplete ? "Complete series" : "Series"} · {series.totalParts} parts
                  </p>
                  <h2 id={`series-title-${series.id}`}>{series.name}</h2>
                </div>
                <p>{series.description}</p>
              </header>
              <WritingList entries={seriesEntries} />
            </section>
          );
        })
      }
      {
        standaloneEntries.length > 0 && (
          <section class="standalone-writing" aria-labelledby="standalone-writing-heading">
            <p class="section-kicker">Essays and notes</p>
            <h2 id="standalone-writing-heading">More writing</h2>
            <WritingList entries={standaloneEntries} />
          </section>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .writing-collection {
    margin-bottom: clamp(5rem, 10vw, 9rem);
  }

  .series-group,
  .standalone-writing {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .series-header {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    margin-bottom: 2rem;
  }

  .series-header h2,
  .standalone-writing h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 630;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .series-header > p {
    max-width: 36rem;
    margin: 0;
    color: var(--text-soft);
  }

  .standalone-writing h2 {
    margin-bottom: 2rem;
  }

  .topic-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .topic-nav > span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topic-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-nav a {
    display: block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .topic-nav a:hover,
  .topic-nav a:focus-visible {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 40rem) {
    .series-header {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .topic-nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .topic-nav ul {
      justify-content: flex-start;
    }
  }
</style>
