---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { alternateLocale, localizedPath, site, type Locale } from "../data/site";
import { topics } from "../data/topics";
import ProjectTopology from "./ProjectTopology.astro";
import SignatureVisual from "./SignatureVisual.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => data.lang === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.find(({ data }) => data.featured);
const secondary = projects.filter(({ data }) => !data.featured).slice(0, 2);
const otherLocale = alternateLocale(locale);

if (!featured) throw new Error(`Missing featured project for locale: ${locale}`);

const copy =
  locale === "en"
    ? {
        title: site.name,
        description:
          "Tô Gia Bảo is a Data Engineer building reliable data platforms, lakehouse systems and AI-powered data products.",
        eyebrow: "Data Engineer · Data Platforms",
        headline: "I build reliable data platforms, end to end.",
        lead: "I'm Tô Gia Bảo, a Data Engineer at Timo Digital Bank. I work across ingestion, orchestration, lakehouse architecture, analytics engineering and AI-powered data products.",
        primary: "Explore selected work",
        secondary: "Read my notes",
        focus: ["Data Platforms", "Lakehouse Architecture", "Cloud Infrastructure"],
        selected: "Selected work",
        allWork: "View all work",
        role: "Sole designer & engineer",
        caseStudy: "Read case study",
        knowledgeKicker: "Knowledge",
        knowledgeTitle: "Engineering notes, built in public.",
        knowledgeBody:
          "I document the decisions behind the systems I build—from table ownership and idempotency to delivery boundaries and typed AI workflows.",
        notesAction: "Browse notes",
        topicCode: "topic",
      }
    : {
        title: site.name,
        description:
          "Tô Gia Bảo là Data Engineer xây dựng nền tảng dữ liệu, hệ thống lakehouse và sản phẩm dữ liệu ứng dụng AI.",
        eyebrow: "Kỹ sư dữ liệu · Nền tảng dữ liệu",
        headline: "Tôi xây dựng nền tảng dữ liệu tin cậy, từ đầu đến cuối.",
        lead: "Tôi là Tô Gia Bảo, hiện làm Data Engineer tại Timo Digital Bank. Tôi làm việc với ingestion, orchestration, kiến trúc lakehouse, analytics engineering và các sản phẩm dữ liệu ứng dụng AI.",
        primary: "Xem các dự án",
        secondary: "Đọc ghi chú",
        focus: ["Nền tảng dữ liệu", "Kiến trúc Lakehouse", "Hạ tầng Cloud"],
        selected: "Dự án chọn lọc",
        allWork: "Xem tất cả dự án",
        role: "Tự thiết kế & xây dựng",
        caseStudy: "Đọc case study",
        knowledgeKicker: "Kiến thức",
        knowledgeTitle: "Ghi chú kỹ thuật, được viết công khai.",
        knowledgeBody:
          "Tôi ghi lại các quyết định phía sau hệ thống mình xây dựng—từ quyền sở hữu table và idempotency đến ranh giới triển khai và typed AI workflow.",
        notesAction: "Xem ghi chú",
        topicCode: "chủ đề",
      };
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  alternatePath={localizedPath(otherLocale)}
>
  <div class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="button-row">
        <a class="button" href="#selected-work">{copy.primary} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={localizedPath(locale, "notes")}>{copy.secondary}</a
        >
      </div>
      <ul
        class="focus-strip"
        aria-label={locale === "en" ? "Current focus" : "Hướng quan tâm hiện tại"}
      >
        {copy.focus.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <SignatureVisual locale={locale} />
  </div>

  <section class="work-band section" id="selected-work">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Work</p>
          <h2>{copy.selected}</h2>
        </div>
        <a class="text-link" href={localizedPath(locale, "work")}>{copy.allWork} →</a>
      </div>

      <article class="featured-project">
        <div>
          <span class="project-index">01 · {copy.role}</span>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.outcome}</p>
          <ul class="tag-list" aria-label="Technology stack">
            {featured.data.stack.slice(0, 5).map((item) => <li>{item}</li>)}
          </ul>
          <a class="text-link" href={localizedPath(locale, `work/${featured.data.slug}`)}>
            {copy.caseStudy}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ProjectTopology locale={locale} />
      </article>

      {
        secondary.map((project, index) => (
          <a class="secondary-project" href={localizedPath(locale, `work/${project.data.slug}`)}>
            <span>{String(index + 2).padStart(2, "0")}</span>
            <h3>{project.data.title}</h3>
            <p>{project.data.outcome}</p>
            <span class="project-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container knowledge-grid">
      <div class="knowledge-intro">
        <p class="section-kicker">02 / {copy.knowledgeKicker}</p>
        <h2>{copy.knowledgeTitle}</h2>
        <p>{copy.knowledgeBody}</p>
        <a class="text-link" href={localizedPath(locale, "notes")}>{copy.notesAction} →</a>
      </div>
      <ul class="topic-list">
        {
          topics.map((topic, index) => (
            <li>
              <span>{topic.label[locale]}</span>
              <code>
                {copy.topicCode}/{String(index + 1).padStart(2, "0")}
              </code>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
