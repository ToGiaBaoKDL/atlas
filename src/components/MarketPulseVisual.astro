---
import VisualHeader from "./VisualHeader.astro";

const stages = [
  { number: "01", owner: "Model", title: "Plan", detail: "Intent + queries" },
  {
    number: "02",
    owner: "Code + providers",
    title: "Search",
    detail: "Bounded URL pool",
  },
  {
    number: "03",
    owner: "Model + provider",
    title: "Select + extract",
    detail: "Source packets",
  },
  {
    number: "04",
    owner: "Model",
    title: "Write",
    detail: "Content + source refs",
  },
];
---

<figure class="market-map">
  <VisualHeader
    eyebrow="Research contract"
    title="Semantic choices inside deterministic limits"
    status="Completed"
  />

  <div class="pipeline" aria-label="VN Market Pulse responsibility pipeline">
    <div class="input-card">
      <span>INPUT</span>
      <strong>Vietnamese topic</strong>
      <small>depth · lookback · style</small>
    </div>

    <ol>
      {
        stages.map((stage, index) => (
          <li>
            <div>
              <>
                <span>{stage.number}</span>
                <small>{stage.owner}</small>
              </>
            </div>
            <strong>{stage.title}</strong>
            <p>{stage.detail}</p>
            {index < stages.length - 1 && <i aria-hidden="true" />}
          </li>
        ))
      }
    </ol>

    <div class="output-card">
      <span>OUTPUT</span>
      <strong>One typed post</strong>
      <small>exact source IDs</small>
    </div>
  </div>

  <div class="guardrail">
    <span class="guardrail-label"><i></i>Code carries the run boundary</span>
    <p>Deadline · provider budget · URL identity · schema and source references</p>
  </div>
</figure>

<style>
  .market-map {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: var(--visual-canvas-ratio, auto);
    min-width: 0;
    grid-template-rows: auto minmax(0, 1fr) auto;
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 16% 15%, rgba(163, 230, 53, 0.08), transparent 28%),
      radial-gradient(circle at 84% 76%, rgba(163, 230, 53, 0.1), transparent 27%), var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto,
      auto;
    padding: clamp(0.8rem, 1.45vw, 1rem);
    color: var(--visual-text);
  }

  .pipeline {
    position: relative;
    display: grid;
    min-height: 0;
    grid-template-columns: 0.68fr minmax(0, 3.7fr) 0.68fr;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    align-items: center;
    padding-block: clamp(0.5rem, 1.1vw, 0.7rem);
  }

  .input-card,
  .output-card {
    display: grid;
    align-content: center;
    min-height: 5.8rem;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: var(--visual-panel-soft);
    padding: 0.6rem;
  }

  .input-card span,
  .input-card small,
  .output-card span,
  .output-card small,
  ol li div span,
  ol li div small,
  .guardrail-label,
  .guardrail p {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .input-card span,
  .output-card span {
    color: var(--visual-muted);
  }

  .input-card strong,
  .output-card strong {
    margin-block: 0.35rem;
    color: var(--visual-text);
    font-size: clamp(0.58rem, 1.1vw, 0.72rem);
    font-weight: 590;
    line-height: 1.25;
  }

  .input-card small,
  .output-card small {
    color: var(--visual-soft);
    line-height: 1.4;
  }

  ol {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.58rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol li {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 5.8rem;
    align-content: center;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-panel) 95%, transparent);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
    padding: clamp(0.55rem, 1.2vw, 0.75rem);
  }

  ol li div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    margin-bottom: clamp(0.55rem, 1.3vw, 0.85rem);
  }

  ol li div span {
    color: var(--visual-accent);
  }

  ol li div small {
    overflow: hidden;
    color: var(--visual-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  ol li strong {
    display: block;
    color: var(--visual-text);
    font-size: clamp(0.62rem, 1.15vw, 0.78rem);
    font-weight: 600;
  }

  ol li p {
    margin: 0.35rem 0 0;
    color: var(--visual-soft);
    font-size: clamp(0.5rem, 0.92vw, 0.61rem);
    line-height: 1.35;
  }

  ol li i {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: calc(100% - 1px);
    width: calc(0.58rem + 2px);
    height: 2px;
    transform: translateY(-50%);
    background: var(--visual-accent-strong);
  }

  ol li i::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.32rem;
    height: 0.32rem;
    transform: translateY(-50%) rotate(45deg);
    border-top: 2px solid var(--visual-accent);
    border-right: 2px solid var(--visual-accent);
    content: "";
  }

  .guardrail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.75rem;
  }

  .guardrail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--visual-accent);
  }

  .guardrail-label i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, currentColor 14%, transparent);
  }

  .guardrail p {
    margin: 0;
    color: var(--visual-soft);
    text-align: right;
    white-space: nowrap;
  }
</style>
