---
import FlowArrow from "./FlowArrow.astro";
import VisualHeader from "./VisualHeader.astro";

const stages = [
  { number: "01", owner: "Model", title: "Plan", detail: "Facets + queries" },
  { number: "02", owner: "Code", title: "Retrieve", detail: "Bounded pool" },
  { number: "03", owner: "Shared", title: "Ground", detail: "Select + extract" },
  { number: "04", owner: "Model", title: "Write", detail: "Typed + cited" },
];
---

<figure class="market-map">
  <VisualHeader
    eyebrow="Research contract"
    title="Semantic choices, deterministic boundaries"
    status="Completed"
  />

  <div class="pipeline" aria-label="VN Market Pulse responsibility pipeline">
    <article class="endpoint">
      <span>Input</span>
      <strong>Request</strong>
      <small>topic · depth · style</small>
    </article>
    <FlowArrow />

    <section class="run-boundary">
      <span class="run-label">Bounded run</span>
      <div class="run-flow">
        {
          stages.map((stage, index) => (
            <>
              <article class="stage">
                <div>
                  <span>{stage.number}</span>
                  <small>{stage.owner}</small>
                </div>
                <strong>{stage.title}</strong>
                <p>{stage.detail}</p>
              </article>
              {index < stages.length - 1 && <FlowArrow />}
            </>
          ))
        }
      </div>
    </section>

    <FlowArrow />

    <article class="endpoint">
      <span>Output</span>
      <strong>Post</strong>
      <small>exact source IDs</small>
    </article>
  </div>

  <div class="guardrail">
    <span><i></i>Code owns execution</span>
    <p>deadline · budget · URL identity · schema · source IDs</p>
  </div>
</figure>

<style>
  .market-map {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: var(--visual-canvas-ratio, auto);
    min-width: 0;
    grid-template-rows: auto minmax(0, 1fr) auto;
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 16% 15%, rgba(163, 230, 53, 0.08), transparent 28%),
      radial-gradient(circle at 84% 76%, rgba(163, 230, 53, 0.1), transparent 27%), var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto,
      auto;
    padding: clamp(0.8rem, 1.45vw, 1rem);
    color: var(--visual-text);
  }

  .pipeline {
    display: grid;
    min-height: 0;
    grid-template-columns:
      minmax(0, 0.68fr) minmax(1.4rem, 0.32fr) minmax(0, 4.65fr) minmax(1.4rem, 0.32fr)
      minmax(0, 0.68fr);
    gap: 0.24rem;
    align-items: center;
    padding-block: clamp(0.8rem, 1.6vw, 1.1rem);
  }

  .run-boundary {
    position: relative;
    min-width: 0;
    border: 1px dashed color-mix(in srgb, var(--visual-accent) 52%, var(--visual-border));
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-accent) 2.5%, transparent);
    padding: 0.78rem 0.48rem 0.48rem;
  }

  .run-label {
    position: absolute;
    top: -0.4rem;
    left: 0.6rem;
    background: var(--visual-bg);
    padding-inline: 0.28rem;
    color: var(--visual-accent);
    font-family: var(--font-mono);
    font-size: 0.44rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .run-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr) minmax(1.15rem, 0.28fr)) minmax(0, 1fr);
    gap: 0.2rem;
    align-items: center;
  }

  article {
    display: grid;
    min-width: 0;
    min-height: 5.2rem;
    align-content: center;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-panel) 95%, transparent);
    padding: clamp(0.45rem, 1vw, 0.62rem);
  }

  .endpoint {
    border-color: color-mix(in srgb, var(--visual-accent) 22%, var(--visual-border));
    background: var(--visual-panel-soft);
  }

  .endpoint:first-child {
    border-left-color: var(--visual-accent-strong);
  }

  .endpoint:last-child {
    border-right-color: var(--visual-accent-strong);
  }

  article span,
  article small,
  .guardrail span,
  .guardrail p {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  article span,
  article small {
    color: var(--visual-muted);
  }

  article strong {
    margin-block: 0.24rem;
    color: var(--visual-text);
    font-size: clamp(0.58rem, 1.05vw, 0.72rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .stage div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem;
    margin-bottom: clamp(0.35rem, 0.8vw, 0.52rem);
  }

  .stage div span {
    color: var(--visual-accent);
  }

  .stage div small {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stage p {
    margin: 0;
    color: var(--visual-soft);
    font-size: clamp(0.5rem, 0.9vw, 0.6rem);
    line-height: 1.3;
  }

  .guardrail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.65rem;
  }

  .guardrail span {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--visual-accent);
  }

  .guardrail span i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, currentColor 14%, transparent);
  }

  .guardrail p {
    margin: 0;
    overflow: hidden;
    color: var(--visual-soft);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
