---
import VisualHeader from "./VisualHeader.astro";

const stages = [
  { number: "01", owner: "Model", title: "Plan", detail: "Intent + query facets" },
  { number: "02", owner: "Code", title: "Pool", detail: "URLs + provider metadata" },
  { number: "03", owner: "Model", title: "Select", detail: "Semantic source choice" },
  { number: "04", owner: "Provider", title: "Extract", detail: "Bounded source packets" },
  { number: "05", owner: "Model", title: "Write", detail: "Content + source refs" },
];
---

<figure class="market-map">
  <VisualHeader
    eyebrow="Research contract"
    title="Semantic choices inside deterministic limits"
    status="Completed"
  />

  <div class="pipeline" aria-label="VN Market Pulse responsibility pipeline">
    <div class="input-card">
      <span>INPUT</span>
      <strong>Vietnamese topic</strong>
      <small>depth · lookback · style</small>
    </div>

    <ol>
      {
        stages.map((stage, index) => (
          <li class:list={[stage.owner.toLowerCase()]}>
            <div>
              <>
                <span>{stage.number}</span>
                <small>{stage.owner}</small>
              </>
            </div>
            <strong>{stage.title}</strong>
            <p>{stage.detail}</p>
            {index < stages.length - 1 && <i aria-hidden="true" />}
          </li>
        ))
      }
    </ol>

    <div class="output-card">
      <span>OUTPUT</span>
      <strong>One typed post</strong>
      <small>exact source IDs</small>
    </div>
  </div>

  <div class="guardrail">
    <span class="guardrail-label"><i></i>Code carries the run boundary</span>
    <ul>
      <li>Deadline</li>
      <li>Provider budget</li>
      <li>URL identity</li>
      <li>Schema validation</li>
      <li>Sanitized failure</li>
    </ul>
  </div>
</figure>

<style>
  .market-map {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.59;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      radial-gradient(circle at 15% 12%, rgba(111, 131, 238, 0.19), transparent 29%),
      radial-gradient(circle at 87% 82%, rgba(120, 207, 145, 0.12), transparent 28%),
      var(--visual-bg);
    background-size:
      1.35rem 1.35rem,
      1.35rem 1.35rem,
      auto,
      auto,
      auto;
    padding: clamp(1rem, 2.7vw, 1.55rem);
    color: var(--visual-text);
  }

  .pipeline {
    display: grid;
    height: calc(100% - 7.4rem);
    grid-template-columns: 0.68fr minmax(0, 3.7fr) 0.68fr;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    align-items: center;
    padding-block: clamp(1rem, 2.4vw, 1.5rem);
  }

  .input-card,
  .output-card {
    display: grid;
    align-content: center;
    min-height: 54%;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: var(--visual-panel-soft);
    padding: 0.6rem;
  }

  .input-card span,
  .input-card small,
  .output-card span,
  .output-card small,
  ol li div span,
  ol li div small,
  .guardrail-label,
  .guardrail li {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .input-card span,
  .output-card span {
    color: var(--visual-muted);
  }

  .input-card strong,
  .output-card strong {
    margin-block: 0.35rem;
    color: var(--visual-text);
    font-size: clamp(0.58rem, 1.1vw, 0.72rem);
    font-weight: 590;
    line-height: 1.25;
  }

  .input-card small,
  .output-card small {
    color: var(--visual-soft);
    line-height: 1.4;
  }

  ol {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.58rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol li {
    position: relative;
    min-width: 0;
    border: 1px solid var(--visual-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--visual-panel) 95%, transparent);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
    padding: clamp(0.55rem, 1.2vw, 0.75rem);
  }

  ol li.model {
    border-top-color: var(--visual-model);
  }

  ol li.code,
  ol li.provider {
    border-top-color: var(--visual-code);
  }

  ol li div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    margin-bottom: clamp(0.8rem, 2.2vw, 1.55rem);
  }

  ol li div span {
    color: var(--visual-accent);
  }

  ol li div small {
    overflow: hidden;
    color: var(--visual-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  ol li strong {
    display: block;
    color: var(--visual-text);
    font-size: clamp(0.62rem, 1.15vw, 0.78rem);
    font-weight: 600;
  }

  ol li p {
    margin: 0.35rem 0 0;
    color: var(--visual-soft);
    font-size: clamp(0.5rem, 0.92vw, 0.61rem);
    line-height: 1.35;
  }

  ol li i {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: calc(100% - 1px);
    width: calc(0.58rem + 2px);
    height: 2px;
    transform: translateY(-50%);
    background: var(--visual-accent-strong);
  }

  ol li i::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.32rem;
    height: 0.32rem;
    transform: translateY(-50%) rotate(45deg);
    border-top: 2px solid var(--visual-accent);
    border-right: 2px solid var(--visual-accent);
    content: "";
  }

  .guardrail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--visual-border-soft);
    padding-top: 0.75rem;
  }

  .guardrail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--visual-code);
  }

  .guardrail-label i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, currentColor 14%, transparent);
  }

  .guardrail ul {
    display: flex;
    justify-content: flex-end;
    gap: 0.38rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guardrail li {
    border: 1px solid var(--visual-border);
    border-radius: 999px;
    padding: 0.23rem 0.45rem;
    color: var(--visual-soft);
    white-space: nowrap;
  }
</style>
