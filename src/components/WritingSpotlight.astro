---
import type { HomepageWritingSeriesSelection } from "../data/content";
import { getWritingSeriesPath } from "../data/series";
import { getWritingSocialCard } from "../data/social-cards";

interface Props {
  groups: HomepageWritingSeriesSelection[];
}

const { groups } = Astro.props;
const spotlights = groups.map((group) => ({
  ...group,
  initialIndex: group.entries.findIndex(
    ({ data }) => data.series?.part === group.series.homepage.part,
  ),
  articles: group.entries.map((entry) => ({
    entry,
    socialCard: getWritingSocialCard(entry),
  })),
}));
---

<div class="container writing-spotlight" data-writing-spotlight data-reveal>
  <header class="spotlight-heading">
    <p class="section-kicker">II / Writing</p>
    <a class="text-link" href="/writing/">View all writing →</a>
  </header>

  {
    spotlights.length > 1 && (
      <div
        class="series-selector"
        role="group"
        aria-label="Choose a writing series"
        data-series-selector
        hidden
      >
        <span class="series-selector-label">Series index</span>
        <div class="series-options">
          {spotlights.map(({ series }, index) => (
            <button
              type="button"
              aria-controls={`homepage-series-${series.id}`}
              aria-pressed={index === 0 ? "true" : "false"}
              data-series-button
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{series.name}</strong>
            </button>
          ))}
        </div>
      </div>
    )
  }

  {
    spotlights.length > 0 ? (
      spotlights.map(({ series, entries, articles, isComplete, initialIndex }, seriesIndex) => (
        <section
          class="series-panel"
          id={`homepage-series-${series.id}`}
          aria-labelledby={`homepage-series-title-${series.id}`}
          data-series-panel
        >
          <div class="series-copy">
            <p class="series-position">
              {spotlights.length > 1
                ? `Series ${String(seriesIndex + 1).padStart(2, "0")} / ${String(spotlights.length).padStart(2, "0")}`
                : "Featured series"}
            </p>
            <h2 id={`homepage-series-title-${series.id}`}>{series.name}</h2>
            <p class="series-description">{series.description}</p>
            <p class="series-meta">
              {isComplete
                ? `Complete series · ${series.totalParts} parts`
                : `In progress · ${entries.length} of ${series.totalParts} parts`}
            </p>
            <a class="text-link" href={getWritingSeriesPath(series.id)}>
              Explore series →
            </a>
          </div>

          <div class="article-carousel" data-article-carousel data-initial-index={initialIndex}>
            <div class="carousel-stage">
              <div
                class="carousel-viewport"
                role="region"
                aria-roledescription="carousel"
                aria-label={`${series.name} articles`}
                data-carousel-viewport
              >
                <ol class="carousel-track">
                  {articles.map(({ entry, socialCard }) => {
                    const part = entry.data.series?.part ?? 1;
                    const partLabel = `Part ${String(part).padStart(2, "0")} / ${String(series.totalParts).padStart(2, "0")}`;

                    return (
                      <li
                        class="carousel-slide"
                        aria-roledescription="slide"
                        aria-label={`Part ${part} of ${series.totalParts}`}
                        data-carousel-slide
                        data-part-label={partLabel}
                      >
                        <a class="article-card" href={`/writing/${entry.id}/`}>
                          <span class="card-image">
                            <img
                              src={socialCard.path}
                              alt=""
                              width="1200"
                              height="630"
                              loading="lazy"
                              decoding="async"
                            />
                          </span>
                          <span class="article-caption">
                            <span>{partLabel}</span>
                            <h3>{entry.data.title}</h3>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </div>

            {articles.length > 1 && (
              <div class="carousel-feedback">
                <p role="status" data-carousel-status>
                  Part {String(entries[initialIndex]?.data.series?.part ?? 1).padStart(2, "0")}
                  {" / "}
                  {String(series.totalParts).padStart(2, "0")}
                </p>
                <p>Swipe or drag to browse</p>
              </div>
            )}
          </div>
        </section>
      ))
    ) : (
      <div class="writing-empty">
        <h2>Technical writing, in progress.</h2>
        <a class="text-link" href="/writing/">
          Explore writing →
        </a>
      </div>
    )
  }
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  document.querySelectorAll<HTMLElement>("[data-writing-spotlight]").forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-series-panel]"));
    const seriesButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-series-button]"),
    );

    const enhanceCarousel = (panel: HTMLElement) => {
      const carousel = panel.querySelector<HTMLElement>("[data-article-carousel]");

      if (!carousel || carousel.hasAttribute("data-enhanced")) return;

      const viewport = carousel.querySelector<HTMLElement>("[data-carousel-viewport]");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
      const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");

      if (!viewport || slides.length === 0) return;

      const initialIndex = Number.parseInt(carousel.dataset.initialIndex ?? "0", 10);
      const embla = EmblaCarousel(viewport, {
        align: "start",
        duration: 18,
        startIndex: Number.isNaN(initialIndex) ? 0 : initialIndex,
      });

      const syncSelection = () => {
        const selectedIndex = embla.selectedScrollSnap();

        slides.forEach((slide, index) => {
          const isSelected = index === selectedIndex;
          slide.inert = !isSelected;
          slide.setAttribute("aria-hidden", String(!isSelected));
        });
        if (status) status.textContent = slides[selectedIndex]?.dataset.partLabel ?? "";
      };

      embla.on("select", syncSelection).on("reInit", syncSelection);
      carousel.setAttribute("data-enhanced", "");
      syncSelection();
    };

    const activateSeries = (index: number) => {
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      seriesButtons.forEach((button, buttonIndex) => {
        button.setAttribute("aria-pressed", String(buttonIndex === index));
      });

      const activePanel = panels[index];
      if (activePanel) enhanceCarousel(activePanel);
    };

    const selector = root.querySelector<HTMLElement>("[data-series-selector]");
    if (selector) selector.hidden = false;

    seriesButtons.forEach((button, index) => {
      button.addEventListener("click", () => activateSeries(index));
    });

    activateSeries(0);
  });
</script>

<style>
  .spotlight-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .spotlight-heading .section-kicker {
    margin: 0;
  }

  .series-selector {
    display: grid;
    grid-template-columns: minmax(16rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: stretch;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
    border-block: 1px solid var(--border);
  }

  .series-selector[hidden] {
    display: none;
  }

  .series-selector-label {
    align-self: center;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .series-options {
    display: flex;
    min-width: 0;
  }

  .series-options button {
    position: relative;
    display: grid;
    min-width: 0;
    flex: 1 1 0;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    min-height: 3.6rem;
    border: 0;
    border-left: 1px solid var(--border);
    background: transparent;
    color: var(--text-soft);
    padding: 0.75rem clamp(0.75rem, 2vw, 1.1rem);
    text-align: left;
    cursor: pointer;
    transition: color var(--motion-fast) ease;
  }

  .series-options button::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--accent);
    content: "";
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .series-options button span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .series-options button strong {
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 570;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-options button:hover,
  .series-options button:focus-visible,
  .series-options button[aria-pressed="true"] {
    color: var(--text);
  }

  .series-options button[aria-pressed="true"] span {
    color: var(--accent-ink);
  }

  .series-options button[aria-pressed="true"]::after {
    transform: scaleX(1);
  }

  .series-options button:focus-visible {
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .series-panel {
    display: grid;
    grid-template-columns: minmax(16rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .series-panel[hidden] {
    display: none;
  }

  .series-copy {
    min-width: 0;
  }

  .series-position,
  .series-meta {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .series-position {
    margin: 0 0 1.2rem;
  }

  .series-copy h2 {
    max-width: 13ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .series-description {
    max-width: 31rem;
    margin: 0;
    color: var(--text-soft);
  }

  .series-meta {
    margin-block: 1.5rem 0.8rem;
  }

  .article-carousel {
    min-width: 0;
  }

  .carousel-stage {
    position: relative;
    isolation: isolate;
  }

  .carousel-stage::before,
  .carousel-stage::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    content: "";
    pointer-events: none;
  }

  .carousel-stage::before {
    transform: translate(0.45rem, 0.45rem);
  }

  .carousel-stage::after {
    transform: translate(0.85rem, 0.85rem);
    opacity: 0.55;
  }

  .carousel-viewport {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .article-carousel[data-enhanced] .carousel-viewport {
    overflow: hidden;
    cursor: grab;
  }

  .article-carousel[data-enhanced] .carousel-viewport:active {
    cursor: grabbing;
  }

  .carousel-track {
    display: flex;
    margin: 0;
    padding: 0;
    touch-action: pan-y pinch-zoom;
    list-style: none;
  }

  .carousel-slide {
    min-width: 0;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .article-card {
    display: grid;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }

  .card-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    background: var(--visual-bg);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-caption {
    display: grid;
    min-height: 6.8rem;
    align-content: center;
    gap: 0.45rem;
    padding: 1rem 1.2rem;
  }

  .article-caption > span {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-caption h3 {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.2;
    transition: color var(--motion-fast) ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .article-card:hover h3,
  .article-card:focus-visible h3 {
    color: var(--accent);
  }

  .carousel-feedback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .carousel-feedback p {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 620;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .carousel-feedback p:last-child {
    text-align: right;
  }

  .writing-empty h2 {
    margin: 0 0 1rem;
  }

  @media (max-width: 56rem) {
    .series-selector {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .series-selector-label {
      padding-block: 0.65rem;
    }

    .series-options {
      overflow-x: auto;
      border-top: 1px solid var(--border);
      scrollbar-width: thin;
    }

    .series-options button {
      min-width: min(17rem, 75vw);
    }

    .series-panel {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .series-copy h2 {
      max-width: 16ch;
    }
  }

  @media (max-width: 40rem) {
    .spotlight-heading {
      align-items: flex-end;
    }

    .series-panel {
      gap: 2rem;
    }

    .series-selector-label {
      display: none;
    }

    .series-options {
      border-top: 0;
    }

    .series-options button {
      min-width: min(15rem, 72vw);
      min-height: 3.1rem;
      padding-block: 0.65rem;
    }

    .series-copy h2 {
      font-size: clamp(2.15rem, 12vw, 3rem);
    }

    .carousel-stage::before {
      transform: translate(0.3rem, 0.3rem);
    }

    .carousel-stage::after {
      transform: translate(0.55rem, 0.55rem);
    }

    .article-caption {
      min-height: 6.2rem;
      padding: 0.9rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-caption h3,
    .series-options button,
    .series-options button::after {
      transition: none;
    }
  }
</style>
