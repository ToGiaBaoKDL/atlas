---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  mode: "desktop" | "mobile";
}

const { headings, mode } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  items.length > 1 && mode === "desktop" && (
    <aside class="toc toc-desktop" data-toc>
      <h2>On this page</h2>
      <nav aria-label="Table of contents">
        <ol>
          {items.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

{
  items.length > 1 && mode === "mobile" && (
    <details class="toc toc-mobile" data-toc>
      <summary>On this page</summary>
      <nav aria-label="Table of contents">
        <ol>
          {items.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .toc-desktop {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .toc h2,
  .toc summary {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc h2 {
    margin: 0 0 0.8rem;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc nav {
    border-inline-start: 1px solid var(--border);
  }

  .toc li.nested a {
    padding-inline-start: 1.75rem;
    font-size: 0.75rem;
  }

  .toc a {
    position: relative;
    display: block;
    padding: 0.6rem 0 0.6rem 1rem;
    color: var(--text-soft);
    font-size: 0.8rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .toc a::before {
    position: absolute;
    top: 0.42rem;
    bottom: 0.42rem;
    left: -1px;
    width: 2px;
    transform: scaleY(0);
    transform-origin: center;
    background: var(--accent);
    content: "";
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .toc a:hover,
  .toc a:focus-visible,
  .toc a[aria-current="location"] {
    color: var(--accent-ink);
  }

  .toc a[aria-current="location"] {
    font-weight: 620;
  }

  .toc a[aria-current="location"]::before {
    transform: scaleY(1);
  }

  .toc-mobile {
    display: none;
    border-block: 1px solid var(--border);
    padding-block: 0.9rem;
  }

  .toc-mobile summary {
    cursor: pointer;
    color: var(--text);
  }

  .toc-mobile nav {
    margin-top: 0.9rem;
  }

  @media (max-width: 56rem) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]'),
  );
  const headingIds = [...new Set(tocLinks.map(({ hash }) => decodeURIComponent(hash.slice(1))))];
  const headingTargets = headingIds
    .map((id) => document.getElementById(id))
    .filter((heading): heading is HTMLElement => heading !== null);

  if (tocLinks.length && headingTargets.length) {
    let frame = 0;

    const updateCurrentHeading = () => {
      frame = 0;
      const scrollPadding = Number.parseFloat(
        getComputedStyle(document.documentElement).scrollPaddingTop,
      );
      const readingLine = (Number.isFinite(scrollPadding) ? scrollPadding : 0) + 1;
      let current = headingTargets[0];

      for (const heading of headingTargets) {
        if (heading.getBoundingClientRect().top > readingLine) break;
        current = heading;
      }

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = headingTargets.at(-1) ?? current;
      }

      tocLinks.forEach((link) => {
        const isCurrent = decodeURIComponent(link.hash.slice(1)) === current.id;
        if (isCurrent) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(updateCurrentHeading);
    };

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    updateCurrentHeading();
  }
</script>
