---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import WritingList from "../../../components/WritingList.astro";
import { getWritingCatalog, type WritingSeriesSelection } from "../../../data/content";

export async function getStaticPaths() {
  const { series } = await getWritingCatalog();

  return series.map((selection) => ({
    params: { id: selection.series.id },
    props: { selection },
  }));
}

interface Props {
  selection: WritingSeriesSelection;
}

const { selection } = Astro.props;
const { series, entries, isComplete } = selection;
const status = isComplete
  ? `Complete · ${series.totalParts} parts`
  : `In progress · ${entries.length} of ${series.totalParts} parts`;
---

<BaseLayout title={series.name} description={series.description} section="writing">
  <div class="container series-page">
    <PageHero
      kicker={`Writing series · ${status}`}
      title={series.name}
      description={series.description}
    />
    <section class="series-articles" aria-label={`${series.name} articles`} data-reveal>
      <header>
        <a class="text-link" href="/writing/">← All writing</a>
        <p>{status}</p>
      </header>
      <WritingList entries={entries} />
    </section>
  </div>
</BaseLayout>

<style>
  .series-page {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .series-articles > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .series-articles > header p {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .series-articles > header {
      align-items: flex-start;
      flex-direction: column-reverse;
    }
  }
</style>
