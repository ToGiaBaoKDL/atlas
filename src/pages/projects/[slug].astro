---
import type { CollectionEntry } from "astro:content";
import ProjectCaseStudy from "../../components/ProjectCaseStudy.astro";
import { getProjects } from "../../data/content";

export async function getStaticPaths() {
  const projectEntries = await getProjects();
  return projectEntries.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<ProjectCaseStudy project={project} />
