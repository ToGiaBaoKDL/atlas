---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <div class="container">
    <PageHero
      kicker="404"
      title="Page not found."
      description="The address may have changed, or the page may not exist yet."
    >
      <div class="button-row page-actions">
        <a class="button" href="/">Return home</a>
      </div>
    </PageHero>
  </div>
</BaseLayout>

<style>
  .page-actions {
    margin-top: 2rem;
  }
</style>
