---
import type { CollectionEntry } from "astro:content";
import PageHero from "../../components/PageHero.astro";
import WritingList from "../../components/WritingList.astro";
import { getPublishedWriting } from "../../data/content";
import { site } from "../../data/site";
import { getTopicLabel, type TopicSlug } from "../../data/topics";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getPublishedWriting();
  const topics = [...new Set(entries.flatMap(({ data }) => data.topics))];

  return topics.map((topic) => ({
    params: { slug: topic },
    props: {
      topic,
      entries: entries.filter(({ data }) => data.topics.includes(topic)),
    },
  }));
}

interface Props {
  topic: TopicSlug;
  entries: CollectionEntry<"writing">[];
}

const { topic, entries } = Astro.props;
const label = getTopicLabel(topic);
const description = `Technical writing by ${site.name} on ${label.toLowerCase()}.`;
---

<BaseLayout title={label} description={description} section="writing">
  <div class="container">
    <PageHero kicker="Writing topic" title={label} description={description}>
      <a class="text-link topic-back" href="/writing/">← All writing</a>
    </PageHero>
    <section class="topic-entries" aria-label={`${label} writing`}>
      <WritingList entries={entries} />
    </section>
  </div>
</BaseLayout>

<style>
  .topic-back {
    display: inline-block;
    margin-top: 1.5rem;
  }

  .topic-entries {
    margin-bottom: clamp(5rem, 10vw, 9rem);
  }
</style>
